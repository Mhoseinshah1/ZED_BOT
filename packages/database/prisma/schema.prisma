// =============================================================================
// Logging / audit
// =============================================================================

model LogTopic {
  id             String   @id @default(uuid())
  key            String   @unique
  title          String
  telegramChatId BigInt?
  topicId        Int?
  isEnabled      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// References are soft (plain ids) so log writes never fail on FK issues and
// history survives entity changes.
model SystemLog {
  id        String         @id @default(uuid())
  level     SystemLogLevel
  eventType String
  message   String
  metadata  Json?
  userId    String?
  adminId   String?
  orderId   String?
  paymentId String?
  serviceId String?
  createdAt DateTime       @default(now())

  deliveries SystemLogDelivery[]

  @@index([level])
  @@index([eventType])
  @@index([userId])
  @@index([createdAt])
}

// Ops-logging phase: one Telegram delivery attempt-tracker per SystemLog x
// topic. The SystemLog row is ALWAYS persisted first (source of truth);
// delivery to the Telegram log group is asynchronous, retried with backoff
// and idempotent - the unique pair plus the SENT CAS guarantee a known
// successful send is never repeated. Delivery failures never propagate to
// the operation that emitted the log, and log-sender failures are written
// only to stdout/stderr and this row (never re-enqueued as Telegram logs).
enum LogDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
  DEAD_LETTER
  SKIPPED
}

model SystemLogDelivery {
  id String @id @default(uuid())

  systemLogId String
  systemLog   SystemLog @relation(fields: [systemLogId], references: [id])
  logTopicId  String?

  status   LogDeliveryStatus @default(PENDING)
  attempts Int               @default(0)

  telegramMessageId Int?
  // Short safe English marker (rate-limited / group-missing / ...) - never
  // raw Telegram API payloads.
  safeErrorCode     String?

  nextAttemptAt DateTime?
  sentAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([systemLogId, logTopicId])
  @@index([status, nextAttemptAt])
}

// Ops-backup phase: one row per database-backup attempt - the durable
// operation record behind the BullMQ database-backup queue. The operation
// id IS the job idempotency key (repeated button callbacks reuse the same
// QUEUED row and job id). Credentials and encryption passwords are NEVER
// stored here; safeErrorCode carries only short scrubbed English markers.
enum BackupOperationStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  VERIFYING
  VERIFIED
  CORRUPT
  CANCELLED
}

enum BackupTrigger {
  MANUAL
  SCHEDULED
  PRE_UPDATE
}

model BackupOperation {
  id String @id @default(uuid())

  status  BackupOperationStatus @default(QUEUED)
  trigger BackupTrigger

  requestedByAdminId String?

  filename       String?
  sizeBytes      BigInt?
  checksumSha256 String?

  encrypted     Boolean @default(false)
  formatVersion Int     @default(1)

  // App/git + pg_dump versions captured into the manifest (non-secret).
  appVersion      String?
  pgClientVersion String?

  safeErrorCode String?

  queuedAt    DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  verifiedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([completedAt])
  @@index([filename])
}

// Direct-log-group-setup phase: the durable operation behind numeric-ID
// (and /setloggroup + start-group wizard) log-group connection. Topic
// creation and the test send run in the BullMQ telegram-log-group-setup
// queue - NEVER inline in a Telegram callback. The row is the resume point
// after a worker restart: topicBindings holds ONLY stable-key -> Telegram
// message-thread-id pairs (never content, tokens or API payloads). The
// active group is switched atomically ONLY after all topics exist and the
// direct SYSTEM test send succeeds; a failed setup leaves the previous
// group untouched. safeErrorCode carries a short scrubbed English marker.
enum LogGroupSetupStatus {
  VALIDATED
  QUEUED
  PROVISIONING
  TESTING
  ACTIVE
  FAILED
  CANCELLED
}

model LogGroupSetupAttempt {
  id String @id @default(uuid())

  // Full chat id is stored because delivery requires it; admin pages and
  // logs always use the masked form.
  chatId    BigInt
  safeTitle String

  status LogGroupSetupStatus @default(VALIDATED)

  requestedByAdminId String

  // Preserved so a failed replacement can be reported against the group
  // that stayed active throughout.
  previousChatId BigInt?
  previousTitle  String?

  // { "<STABLE_KEY>": <messageThreadId> } - the staged topics created so
  // far, so a worker restart resumes instead of recreating them.
  topicBindings     Json?
  createdTopicCount Int     @default(0)
  // True once the staged SYSTEM direct test send was accepted by Telegram.
  directTestOk      Boolean @default(false)

  safeErrorCode  String?
  idempotencyKey String  @unique

  // DB-authoritative "only one setup running at a time": set to 1 while the
  // attempt occupies the single active-setup slot (QUEUED/PROVISIONING/
  // TESTING), NULL otherwise. Prisma treats NULLs as distinct, so any number
  // of preview/finished/cancelled rows coexist while at most one runs.
  activeSlot Int?

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([activeSlot])
  @@index([status, createdAt])
  @@index([chatId])
}

model AuditLog {
  id              String    @id @default(uuid())
  actorTelegramId BigInt?
  actorType       ActorType
  action          String
  entityType      String?
  entityId        String?
  metadata        Json?
  createdAt       DateTime  @default(now())

  @@index([actorType])
  @@index([createdAt])
}

// =============================================================================
// Settings (flexible global configuration)
// =============================================================================

model Setting {
  id        String      @id @default(uuid())
  key       String      @unique
  value     String
  type      SettingType
  isPublic  Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

// =============================================================================
// Automated notification / customer-retention engine
// (feat/notification-retention-engine). Additive: existing installs default to
// the whole system DISABLED (Setting automated_notifications_enabled=false) and
// no historical rows are fabricated. Every notification is generated from fresh
// authoritative state, persisted BEFORE delivery, deduplicated by a stable
// dedupeKey, delivered asynchronously by the worker and safely retryable.
// payloadSnapshot carries ONLY safe render data - never subscription URLs /
// tokens / panel credentials / provider payloads / raw user input.
// =============================================================================

/**
 * Language-neutral notification kind. Category + delivery are derived.
 */
enum AutomatedNotificationType {
  SERVICE_EXPIRY
  SERVICE_TRAFFIC
  SERVICE_EXPIRED
  SERVICE_LIMITED
  TRIAL_NEAR_EXPIRY
  TRIAL_EXPIRED
  ABANDONED_CHECKOUT
  PAYMENT_RETRY
  CUSTOMER_WINBACK
  // Phase 2.1 — Telegram Stars subscription lifecycle (all PAYMENT category).
  STARS_SUBSCRIPTION_ACTIVATED
  STARS_SUBSCRIPTION_RENEWED
  STARS_SUBSCRIPTION_CANCELLED
  STARS_SUBSCRIPTION_PAST_DUE
  STARS_SUBSCRIPTION_REQUIRES_ACTION
  STARS_SUBSCRIPTION_REFUNDED
  STARS_SUBSCRIPTION_PRICE_VERSION_CHANGED
  // Corrective Phase — durable advance notice before a wallet auto-renewal
  // deduction (PAYMENT category; normally delivered ~24h before the charge).
  AUTO_RENEWAL_UPCOMING
}

/**
 * The user-preference category a notification is gated by.
 */
enum AutomatedNotificationCategory {
  SERVICE
  PAYMENT
  MARKETING
}

/**
 * Notification lifecycle. SCHEDULED->READY->SENDING->SENT is the happy path;
 * FAILED/DEAD_LETTER are retry/exhaustion; CANCELLED/SUPPRESSED/EXPIRED are the
 * pre-delivery cancellations (stale source, preference off, past availability).
 */
enum AutomatedNotificationStatus {
  SCHEDULED
  READY
  SENDING
  SENT
  FAILED
  DEAD_LETTER
  CANCELLED
  SUPPRESSED
  EXPIRED
}

/**
 * The stable click action a notification button records + routes to.
 */
enum NotificationInteractionType {
  OPEN_SERVICE
  RENEW_SERVICE
  BUY_EXTRA_VOLUME
  CONTINUE_CHECKOUT
  VIEW_PRODUCTS
  DISMISS
  // Phase 3 (customer win-back). VIEW_PRODUCTS is reused for the "view plans"
  // action; these are the win-back-specific interactions.
  VIEW_WALLET
  SNOOZE_WINBACK
  MARKETING_OPT_OUT
  // Phase 2.1 — Stars subscription notification actions (OPEN_SERVICE + VIEW_PRODUCTS
  // are reused for "view service" / "create new subscription").
  VIEW_SUBSCRIPTION
  REACTIVATE_SUBSCRIPTION
  PAYMENT_SUPPORT
  // Corrective Phase — wallet auto-renewal upcoming notice actions. VIEW_WALLET is
  // reused for the "open wallet" button; these two are auto-renewal-specific.
  VIEW_AUTO_RENEWAL
  CANCEL_AUTO_RENEWAL
}

/**
 * Analytics phase (Phase 4) — the kind of evidence-backed conversion an
 * attribution records. DIRECT_* require hard entity equality (the completed
 * Order's checkoutSession / service equals the one the notification pointed at);
 * ASSISTED_WINBACK is a same-user new purchase after a recorded win-back click
 * within the window (NO entity link — hence "assisted", never "direct"). The
 * value never asserts the notification CAUSED the purchase, only that recorded
 * evidence (a persisted click before a completed order) supports attribution.
 */
enum NotificationAttributionKind {
  DIRECT_CHECKOUT
  DIRECT_SERVICE
  ASSISTED_WINBACK
}

/**
 * Analytics phase (Phase 4) — attribution lifecycle. ACTIVE = a live, evidence-
 * backed attribution counting toward attributed gross+net revenue. REVERSED =
 * the underlying Order was later refunded / voided (Order left COMPLETED, or a
 * refunding WalletTransaction appeared); its revenue is moved to reversed and net
 * drops to zero. Reversal is idempotent (reversedAt stamped once).
 */
enum NotificationAttributionStatus {
  ACTIVE
  REVERSED
}

/**
 * One persisted automated notification. Created SCHEDULED by a worker scan from
 * fresh state, promoted to READY when due + not quiet, and delivered by the
 * delivery worker (CAS SENDING -> SENT/FAILED/DEAD_LETTER). dedupeKey enforces
 * "one per (service|checkout|payment|user), threshold and cycle" across worker
 * restarts, scan retries, duplicate schedulers, timezone math and concurrent
 * scans. The source id columns are OPTIONAL soft references (no hard FK) so
 * cleanup/retention never cascades into business rows; userId is the one hard
 * relation (owner scoping + settings suppression).
 */
model AutomatedNotification {
  id String @id @default(uuid())

  type     AutomatedNotificationType
  category AutomatedNotificationCategory
  status   AutomatedNotificationStatus   @default(SCHEDULED)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Soft references (index-only, no FK) - the notification survives its source
  // row's cleanup and never cascades a delete into business tables.
  serviceId         String?
  checkoutSessionId String?
  paymentId         String?

  // "one per source + threshold + cycle" - see docs/service-notification-rules.md.
  dedupeKey String @unique

  // Bumped when a rule's dedupe/eligibility semantics change so old dedupe keys
  // do not suppress a corrected notification.
  ruleVersion Int @default(1)

  scheduledFor   DateTime
  // After this instant the notification is no longer relevant (rendered stale)
  // and is EXPIRED instead of sent.
  availableUntil DateTime?

  // Safe render data ONLY (masked names, percentages, remaining bytes/time,
  // action eligibility). NEVER credentials / links / provider payloads.
  payloadSnapshot Json

  attempts Int @default(0)

  safeErrorCode     String?
  telegramMessageId Int?

  sentAt       DateTime?
  failedAt     DateTime?
  cancelledAt  DateTime?
  suppressedAt DateTime?
  // Set when the row is moved to SENDING, so a crashed/orphaned SENDING row
  // is safely re-claimable by the reconcile job after a bounded age.
  claimedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interactions NotificationInteraction[]

  @@index([status, scheduledFor])
  @@index([userId, createdAt])
  @@index([serviceId, type])
  @@index([checkoutSessionId, type])
  @@index([paymentId, type])
}

/**
 * A recorded button click on a notification. Unique per (notification, action)
 * so callback retries never inflate click metrics; a genuinely repeatable
 * action (none today) would relax this.
 */
model NotificationInteraction {
  id String @id @default(uuid())

  notificationId String
  notification   AutomatedNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  userId String
  user   User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationInteractionType

  createdAt DateTime @default(now())

  @@unique([notificationId, type])
  @@index([userId, createdAt])
}

/**
 * Per-user automated-notification delivery preferences that do NOT already live
 * on the User model (the five User.*NotificationsEnabled/marketingMessagesEnabled
 * booleans remain authoritative for their categories). Quiet-hours are stored as
 * minutes-since-local-midnight; timezone is an allowlisted IANA name (null =>
 * the global default). Absent row => all defaults (no quiet hours, global limit).
 */
model NotificationPreference {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  timezone               String?
  quietHoursEnabled      Boolean @default(false)
  quietHoursStartMinutes Int?
  quietHoursEndMinutes   Int?

  dailyAutomatedLimit Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Optional per-service override of the user's global service-notification
 * preferences. A null field inherits the user's global setting; only an
 * explicit false disables that service's category. Kept in a side table so the
 * Service model never accumulates notification booleans.
 */
model ServiceNotificationPreference {
  id String @id @default(uuid())

  serviceId String  @unique
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  expiryEnabled  Boolean?
  trafficEnabled Boolean?
  statusEnabled  Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Checkout-payment reminders phase (Phase 2): per-checkout reminder suppression.
 * The «دیگر یادآوری نکن» / «عدم یادآوری این سفارش» buttons persist a suppression
 * instant HERE - never touching the user's global payment-notification switch or
 * any other checkout. checkoutSessionId is a SOFT reference (unique String, no
 * FK) matching the AutomatedNotification convention: notification data never
 * cascades into (or is cascaded by) financial rows. Suppression history is never
 * hard-deleted; a repeated suppression callback is idempotent (upsert on the
 * unique checkoutSessionId, timestamp stamped once).
 */
model CheckoutNotificationPreference {
  id String @id @default(uuid())

  checkoutSessionId String @unique

  abandonedReminderSuppressedAt DateTime?
  paymentRetrySuppressedAt      DateTime?

  suppressedByNotificationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Analytics phase (Phase 4): ONE evidence-backed conversion attribution linking a
 * completed paid Order to the notification whose recorded click preceded it.
 * Convergence authority (never fabricate a conversion, never double-count):
 * - orderId is @unique          -> one Order has AT MOST one attribution.
 * - interactionId is @unique    -> one recorded click backs AT MOST one Order.
 * Both a low-latency after-commit hook and a periodic reconciler write through
 * these constraints, so a racing double-write surfaces as P2002 and is resolved
 * idempotently by re-reading the winner — an Order is never attributed twice.
 * Every reference (orderId / notificationId / interactionId / userId) is a SOFT
 * reference (indexed String, NO FK), mirroring AutomatedNotification: notification
 * history retention cleanup can prune the source notification/interaction rows
 * WITHOUT cascading into — or being cascaded by — this financial-analytics table.
 * evidenceSnapshot holds ONLY safe, non-PII evidence (types, kind, the four
 * timestamps, entity-equality booleans, the window in seconds) — never a service
 * username, subscription link, price beyond the order's own finalPriceToman, or
 * any provider payload. Revenue is the Order's finalPriceToman ONLY; gross/net are
 * attributed revenue, NEVER "profit" (no cost is known here).
 */
model NotificationConversionAttribution {
  id String @id @default(uuid())

  kind   NotificationAttributionKind
  status NotificationAttributionStatus @default(ACTIVE)

  // The completed paid Order (convergence authority — one Order, one attribution).
  orderId String @unique

  // Soft references (index-only, no FK) so notification retention cleanup never
  // cascades into this table. interactionId is unique: one click -> one Order.
  notificationId String
  interactionId  String @unique
  userId         String

  // Denormalized SAFE dimensions for DB-side breakdowns without re-joining a
  // possibly-pruned notification: the source notification type and the recorded
  // click action. (category is derivable from the type in the shared contract.)
  notificationType AutomatedNotificationType
  interactionType  NotificationInteractionType

  // Attributed revenue (Toman). gross = the Order.finalPriceToman captured at
  // attribution; reversed is moved here on refund; net = gross - reversed. These
  // are attributed REVENUE figures, never profit.
  grossRevenueToman    Int @default(0)
  reversedRevenueToman Int @default(0)
  netRevenueToman      Int @default(0)

  // Evidence timestamps: sent -> click -> order-completed (strictly increasing).
  // notificationSentAt anchors the COHORT view; orderCompletedAt anchors the
  // CONVERSION-TIMELINE view. windowSeconds = orderCompletedAt - notificationSentAt.
  notificationSentAt DateTime
  interactionAt      DateTime
  orderCompletedAt   DateTime
  windowSeconds      Int

  // Safe, non-PII evidence used to justify (and later re-verify) the attribution.
  evidenceSnapshot Json

  attributedAt DateTime  @default(now())
  reversedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Conversion-timeline view (default reporting anchor) + cohort view.
  @@index([status, orderCompletedAt])
  @@index([status, notificationSentAt])
  @@index([kind, status])
  @@index([notificationType, status])
  @@index([userId])
  @@index([notificationId])
}

/**
 * Customer win-back (Phase 3): per-user retention state that is NOT already
 * represented on the User model. The permanent marketing opt-out stays on
 * `User.marketingMessagesEnabled` (authoritative) - this side table only holds
 * the temporary win-back snooze. `winbackSnoozedUntil` suppresses CUSTOMER_WINBACK
 * ONLY; it never affects Service notifications, payment reminders or support.
 * The snooze is a history-preserving upsert on the unique userId (a repeated
 * snooze callback is idempotent - the instant is not extended unless the user
 * starts a new snooze). Derived lifecycle segments are NEVER persisted here; they
 * are always recomputed from authoritative rows.
 */
model CustomerRetentionPreference {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  winbackSnoozedUntil         DateTime?
  lastSnoozedByNotificationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================================================
// Wallet auto-renewal (Phase 1) — consent-based, wallet-funded automatic renewal
// of an EXISTING VPN Service in place. Disabled globally by default; no mandate
// is ever created without an explicit, versioned user confirmation. See
// docs/wallet-auto-renewal.md and docs/wallet-auto-renewal-consent.md.
// =============================================================================

/**
 * Mandate lifecycle. A CANCELLED mandate reactivates only via fresh consent.
 */
/**
 * How an automatic-renewal mandate is funded (Phase 2). WALLET is the Phase-1
 * default (existing rows backfill to WALLET); TELEGRAM_STARS is funded by a
 * Telegram Stars subscription. Invariant: one Service has AT MOST ONE mandate
 * (`ServiceAutoRenewalMandate.serviceId @unique`), so a Service can never have
 * both wallet auto-renewal and a Stars subscription at once. The worker wallet
 * scan only ever processes `fundingMethod = WALLET` mandates.
 */
enum AutoRenewalFundingMethod {
  WALLET
  TELEGRAM_STARS
}

/**
 * Telegram Stars service-subscription lifecycle (Phase 2). Distinct from the
 * generic mandate status so wallet and Stars automation never share a state
 * machine. PENDING_PAYMENT until the first recurring charge fulfils;
 * CANCEL_AT_PERIOD_END keeps the paid period active but stops future extension.
 */
enum TelegramStarsSubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  CANCEL_AT_PERIOD_END
  REACTIVATION_ALLOWED
  PAST_DUE
  EXPIRED
  REQUIRES_ACTION
  CANCELLED
}

/**
 * One Telegram Stars subscription CHARGE's processing lifecycle (Phase 2). Each
 * unique `telegram_payment_charge_id` maps to exactly one charge row; the status
 * drives the all-or-nothing settlement, refund and reconciliation transitions.
 */
enum TelegramStarsSubscriptionChargeStatus {
  RECEIVED
  SETTLING
  FULFILLING
  COMPLETED
  RECONCILIATION_REQUIRED
  REFUND_PENDING
  REFUNDED
  FAILED
  IGNORED
}

/**
 * Phase 2.1 — how a charge's payment evidence was obtained. A live
 * successful_payment update carries the complete authoritative object; a charge
 * recovered from getStarTransactions carries a smaller StarTransaction and is
 * marked STAR_TRANSACTION_RECOVERY. Existing rows backfill to
 * LIVE_SUCCESSFUL_PAYMENT (they predate recovery).
 */
enum TelegramStarsChargeEvidenceSource {
  LIVE_SUCCESSFUL_PAYMENT
  STAR_TRANSACTION_RECOVERY
}

/**
 * Phase 2.1 — whether the charge's period-end is Telegram's exact
 * subscription_expiration_date (LIVE_EXACT) or was derived from the recovered
 * transaction date + subscription period (RECOVERED_DERIVED). A recovered charge
 * is never presented as an exact Telegram expiration; a later live update
 * upgrades it to LIVE_EXACT.
 */
enum TelegramStarsPeriodEndSource {
  LIVE_EXACT
  RECOVERED_DERIVED
}

enum AutoRenewalMandateStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

/**
 * Why an ACTIVE mandate was paused (safe, non-PII marker; user-visible reason).
 */
enum AutoRenewalPauseReason {
  USER_PAUSED
  ADMIN_PAUSED
  INSUFFICIENT_BALANCE
  PRICE_ABOVE_LIMIT
  PRODUCT_UNAVAILABLE
  PANEL_UNAVAILABLE
  SERVICE_INELIGIBLE
  SERVICE_STATE_UNCERTAIN
  FINANCIAL_REVIEW
  FULFILLMENT_REVIEW
  SYSTEM_DISABLED
}

/**
 * One durable auto-renewal attempt's lifecycle (one per Service expiry cycle).
 */
enum AutoRenewalAttemptStatus {
  SCHEDULED
  CLAIMED
  PAYMENT_CREATED
  FULFILLING
  COMPLETED
  INSUFFICIENT_BALANCE
  REQUIRES_ACTION
  FAILED
  DEAD_LETTER
  CANCELLED
  SKIPPED
}

/**
 * A user's explicit, versioned CONSENT to auto-renew ONE Service from their
 * wallet, bounded by a maximum authorized charge. Invariant: one Service → at
 * most one mandate (`serviceId @unique`). userId/serviceId/productId are soft
 * references (indexed String, no FK) so the mandate/attempt history survives
 * cleanup of unrelated rows and never cascades into financial tables. A cancelled
 * mandate is only reactivated through a fresh confirmation; a changed Product or
 * a higher maximumChargeToman requires new consent (never silently mutated).
 */
model ServiceAutoRenewalMandate {
  id String @id @default(uuid())

  userId    String
  serviceId String @unique
  productId String

  // Phase 2: how this mandate is funded. Existing rows backfill to WALLET. The
  // worker wallet scan filters on WALLET; a TELEGRAM_STARS mandate is driven by
  // its TelegramStarsServiceSubscription instead and is never wallet-charged.
  fundingMethod AutoRenewalFundingMethod @default(WALLET)

  status      AutoRenewalMandateStatus @default(ACTIVE)
  pauseReason AutoRenewalPauseReason?

  // The user-approved wallet ceiling + the plan price shown at consent time.
  // Wallet-only semantics; a TELEGRAM_STARS mandate stores 0 here (its fixed
  // Stars amount lives on the subscription) and is never reached by the wallet
  // scan.
  maximumChargeToman  Int
  consentedPriceToman Int

  // How long before expiry the renewal is attempted, and whether an
  // insufficient-balance result schedules bounded retries.
  chargeLeadMinutes               Int
  insufficientBalanceRetryEnabled Boolean @default(true)

  consentVersion Int
  consentedAt    DateTime
  cancelledAt    DateTime?
  pausedAt       DateTime?

  nextEvaluationAt      DateTime?
  lastEvaluatedAt       DateTime?
  lastAttemptAt         DateTime?
  lastSuccessfulAt      DateTime?
  lastSuccessfulOrderId String?

  consecutiveFailureCount Int     @default(0)
  safeLastErrorCode       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts          ServiceAutoRenewalAttempt[]
  starsSubscription TelegramStarsServiceSubscription?

  @@index([status, nextEvaluationAt])
  @@index([userId, status])
  @@index([productId])
  @@index([fundingMethod, status])
}

/**
 * One durable auto-renewal ATTEMPT per Service expiry cycle. The database
 * guarantees at-most-once wallet renewal per cycle:
 * - `@@unique([mandateId, expiryCycleFingerprint])` — repeated scans reuse the
 * same attempt; a new cycle (after a successful renewal extends the Service)
 * yields a new fingerprint and a fresh attempt.
 * - `idempotencyKey @unique` — the wallet settlement's stable key (derived from
 * mandate + cycle), so the same attempt can never deduct twice and a worker
 * restart resumes rather than re-charges.
 * checkoutSessionId/paymentId/orderId are soft references linking the created
 * financial rows for audit/reporting.
 */
model ServiceAutoRenewalAttempt {
  id String @id @default(uuid())

  mandateId String
  mandate   ServiceAutoRenewalMandate @relation(fields: [mandateId], references: [id], onDelete: Cascade)

  serviceId String
  userId    String
  productId String

  status AutoRenewalAttemptStatus @default(SCHEDULED)

  expiryCycleFingerprint String
  idempotencyKey         String @unique

  expectedServiceExpiresAt     DateTime?
  expectedProductPriceToman    Int
  authorizedMaximumChargeToman Int

  checkoutSessionId String?
  paymentId         String?
  orderId           String?

  attemptNumber Int       @default(1)
  nextAttemptAt DateTime?

  safeErrorCode String?

  claimedAt        DateTime?
  paymentCreatedAt DateTime?
  completedAt      DateTime?
  failedAt         DateTime?
  cancelledAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mandateId, expiryCycleFingerprint])
  @@index([status, nextAttemptAt])
  @@index([serviceId, createdAt])
  @@index([userId, createdAt])
}

/**
 * Telegram Stars recurring service subscription (Phase 2). Backed by a
 * TELEGRAM_STARS mandate (`mandateId @unique`), so the Phase-1 `serviceId @unique`
 * on the mandate is the single exclusivity authority: one Service → one
 * automation funding method. Holds the FIXED recurring Stars amount, the FROZEN
 * Product version + entitlement snapshot (later cycles apply this contract, not a
 * mutated live Product), the authoritative first charge id (required by
 * `editUserStarSubscription`), and the current-period expiry. `publicPayloadId` is
 * a non-enumerable identifier carried in the `zedbot:sub:<publicPayloadId>` invoice
 * payload — no user/service/product id, no price, no secret. userId/serviceId/
 * productId are soft references (no FK) so history survives unrelated cleanup.
 */
model TelegramStarsServiceSubscription {
  id String @id @default(uuid())

  mandateId String                    @unique
  mandate   ServiceAutoRenewalMandate @relation(fields: [mandateId], references: [id], onDelete: Cascade)

  userId    String
  serviceId String @unique
  productId String

  status TelegramStarsSubscriptionStatus @default(PENDING_PAYMENT)

  // Non-enumerable public identity carried in the invoice payload.
  publicPayloadId String @unique

  // The FIXED recurring contract. Telegram charges this exact amount every period.
  starsAmount               Int
  subscriptionPeriodSeconds Int @default(2592000)

  // Frozen at enrollment; later cycles apply this contract, never a mutated Product.
  productVersion      Int
  entitlementSnapshot Json

  consentVersion  Int
  consentedAt     DateTime
  termsAcceptedAt DateTime

  // The authoritative FIRST subscription charge id (Telegram requires it for
  // edit/cancel/reactivate) and its local Payment.
  initialPaymentId               String?
  initialTelegramPaymentChargeId String? @unique

  currentPeriodStartedAt DateTime?
  currentPeriodEndsAt    DateTime?
  nextExpectedChargeAt   DateTime?

  telegramExtensionCanceled Boolean @default(false)

  cancellationRequestedAt DateTime?
  cancellationConfirmedAt DateTime?
  reactivationRequestedAt DateTime?

  // Phase 2.1 — the last authoritative Bot API subscription-state Update
  // (BotSubscriptionUpdated.state: "canceled" | "active" | "failed") and when it
  // arrived. Persist ONLY the safe state string + timestamp, never raw Update data.
  lastSubscriptionUpdateState String?
  subscriptionUpdateAt        DateTime?
  // When the worker marked this subscription PAST_DUE (period+grace elapsed with no
  // recurring charge). Cleared when a delayed charge recovers it to ACTIVE.
  pastDueMarkedAt             DateTime?

  lastChargeAt          DateTime?
  lastSuccessfulOrderId String?
  safeLastErrorCode     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  charges TelegramStarsSubscriptionCharge[]

  @@index([status, nextExpectedChargeAt])
  @@index([userId, status])
  @@index([productId])
}

/**
 * One Telegram Stars subscription CHARGE (Phase 2). The idempotency spine: one
 * `telegramPaymentChargeId @unique` → one charge → at most one Payment / Checkout /
 * Order / applied renewal (all `@unique`). A duplicate Telegram update for the same
 * charge id returns the existing charge's result. Only Telegram's safe fields are
 * stored — never the raw update, never `order_info`.
 */
model TelegramStarsSubscriptionCharge {
  id String @id @default(uuid())

  subscriptionId String
  subscription   TelegramStarsServiceSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  telegramPaymentChargeId String  @unique
  providerPaymentChargeId String?

  starsAmount                Int
  isFirstRecurring           Boolean
  subscriptionExpirationDate DateTime

  status TelegramStarsSubscriptionChargeStatus @default(RECEIVED)

  paymentId         String? @unique
  checkoutSessionId String? @unique
  orderId           String? @unique

  receivedAt           DateTime  @default(now())
  settlementStartedAt  DateTime?
  fulfillmentStartedAt DateTime?
  completedAt          DateTime?

  refundRequestedAt DateTime?
  refundedAt        DateTime?
  refundAttempts    Int       @default(0)

  // Phase 2.1 recovery evidence. A live charge is LIVE_SUCCESSFUL_PAYMENT +
  // LIVE_EXACT; a getStarTransactions-recovered charge is STAR_TRANSACTION_RECOVERY
  // with a RECOVERED_DERIVED period end (telegramTransactionAt + period). A later
  // live update upgrades periodEndSource to LIVE_EXACT WITHOUT creating a 2nd chain.
  evidenceSource        TelegramStarsChargeEvidenceSource @default(LIVE_SUCCESSFUL_PAYMENT)
  telegramTransactionAt DateTime?
  periodEndSource       TelegramStarsPeriodEndSource      @default(LIVE_EXACT)
  recoveredAt           DateTime?

  safeErrorCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId, receivedAt])
  @@index([status, createdAt])
  @@index([evidenceSource, status])
}

/**
 * Phase 2.1 — the single-row cursor for worker-owned getStarTransactions
 * reconciliation (offset pagination). Coordination only, NEVER financial authority
 * (the unique telegramPaymentChargeId is the authority). Holds NO token, raw charge
 * id, user id, payload or Telegram response — only a bounded offset, bootstrap
 * state, a one-way hash of the last transaction id, and safe run health.
 */
model TelegramStarsReconciliationCursor {
  singletonKey String @id @default("default")

  nextOffset Int @default(0)

  bootstrapCompleted Boolean   @default(false)
  bootstrapStartedAt DateTime?

  lastTransactionAt     DateTime?
  lastTransactionIdHash String?

  lastSuccessfulRunAt     DateTime?
  lastFailedRunAt         DateTime?
  consecutiveFailureCount Int       @default(0)
  safeLastErrorCode       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================================================
// Representative Program (feat/representative-program)
//
// A controlled reseller-price program: a user APPLIES to become a
// representative, the OWNER approves and assigns a pricing TIER, and the
// representative may then buy eligible SERVICE_PRODUCT items at reseller prices
// for their OWN account through the existing checkout/payment/provisioning
// stack. These five tables are PURELY ADDITIVE. They store NO money, NO wallet
// balance, NO commission, NO debt and NO second ledger — representative pricing
// only changes the FINAL product price of a normal checkout (§6). Statuses and
// modes are stored as text columns validated by the @zedbot/shared contract
// (never a Persian label), matching the AdminServiceOperation precedent.
// Records are never hard-deleted; tiers and product prices are archived/disabled
// instead of removed when audit history exists.
// =============================================================================

// One reseller-program application by one user. At most ONE OPEN application
// (DRAFT or PENDING_REVIEW) per user is enforced by a partial unique index in
// the migration; terminal applications (APPROVED/REJECTED/WITHDRAWN) are kept
// for history. Applicant free-text (explanation/experience) and contact fields
// (phone/city) are stored here but NEVER logged (§24).
model RepresentativeApplication {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // REPRESENTATIVE_APPLICATION_STATUSES code (@zedbot/shared).
  status String @default("DRAFT")

  // Applicant-provided profile (bounded plain text).
  fullName                 String
  phone                    String // normalized 09XXXXXXXXX
  province                 String
  city                     String
  salesChannel             String // REPRESENTATIVE_SALES_CHANNELS code
  expectedMonthlyCustomers Int
  experience               String? // optional; empty allowed
  explanation              String // motivation; never logged

  // OWNER review outcome. decisionReason is MANDATORY on rejection and shown to
  // the applicant; stored, never logged (§13, §24).
  reviewedByAdminId String? // soft admin reference (audit survives admin change)
  decisionReason    String?
  submittedAt       DateTime? // DRAFT -> PENDING_REVIEW
  decidedAt         DateTime? // -> APPROVED / REJECTED

  // Telegram replay convergence: the inbound update that submitted the app.
  sourceUpdateId BigInt? @unique

  // The Representative created when this application is approved (1:1).
  approvedRepresentative Representative? @relation("RepresentativeApprovedApplication")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
}

// At most ONE Representative per user (userId @unique). TERMINATED is
// irreversible; the row is retained (never hard-deleted — §20).
model Representative {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation("UserRepresentative", fields: [userId], references: [id])

  // The approved application that created this representative (1:1). SetNull so
  // history survives even if an application row is ever removed.
  approvedApplicationId String?                    @unique
  approvedApplication   RepresentativeApplication? @relation("RepresentativeApprovedApplication", fields: [approvedApplicationId], references: [id], onDelete: SetNull)

  // REPRESENTATIVE_STATUSES code: ACTIVE / SUSPENDED / TERMINATED.
  status String @default("ACTIVE")

  // Assigned pricing tier. SetNull so archiving/removing a tier never deletes
  // the representative; with no active tier the representative buys at retail.
  tierId String?
  tier   RepresentativeTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)

  // Per-representative reseller-checkout permission (§13), independent of the
  // global representative_checkout_enabled switch. Turning it off never cancels
  // a settled Payment or paid Order (§3, §16).
  checkoutEnabled Boolean @default(true)

  approvedByAdminId   String? // soft admin references (audit survives admin change)
  suspendedByAdminId  String?
  terminatedByAdminId String?
  statusReason        String? // last lifecycle reason (suspend/terminate); never logged
  approvedAt          DateTime?
  suspendedAt         DateTime?
  terminatedAt        DateTime?

  purchases RepresentativePurchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([tierId])
}

// A named pricing tier. Behaviour binds to the stable `slug`, not the
// operator-facing `name`. Archived tiers are hidden from new assignment but
// retained; a tier is NEVER hard-deleted while representatives or prices
// reference it (§18) — it is archived (isActive=false) instead.
model RepresentativeTier {
  id          String  @id @default(uuid())
  slug        String  @unique // stable machine code (representativeTierSlug)
  name        String // operator-facing label
  description String?

  isActive   Boolean   @default(true)
  archivedAt DateTime?

  sortOrder Int @default(0) // deterministic ordering in the admin list

  createdByAdminId String? // soft admin reference

  representatives Representative[]
  productPrices   RepresentativeProductPrice[]
  purchases       RepresentativePurchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// The reseller price for one product within one tier. Exactly ONE definition
// per (tier, product) — editing updates this row in place; archiving flips
// isActive (never hard-deleted when audit history exists — §19). FIXED_TOMAN
// stores an exact Toman amount (>=1, <= retail at activation); PERCENT_DISCOUNT
// stores an integer percent in [1,95] and the resolved Toman price is computed
// (floored) from the LIVE retail at checkout time.
model RepresentativeProductPrice {
  id        String             @id @default(uuid())
  tierId    String
  tier      RepresentativeTier @relation(fields: [tierId], references: [id])
  productId String
  product   Product            @relation(fields: [productId], references: [id])

  priceMode       String // REPRESENTATIVE_PRICE_MODES code
  fixedPriceToman Int?
  percentValue    Int?

  isActive   Boolean   @default(true)
  archivedAt DateTime?

  createdByAdminId String? // soft admin reference

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tierId, productId])
  @@index([productId])
}

// A NON-financial link/marker between a representative-priced checkout and the
// REUSED CheckoutSession/Payment/Order. It holds NO money and never gates
// settlement. The financial rows are linked by unique text columns WITHOUT a
// Prisma relation, so the financial tables stay fully isolated — this marker
// can never block or cascade a CheckoutSession/Payment/Order (§6). Uniqueness
// on each link gives idempotency: one purchase row per checkout/payment/order
// (§25). The immutable pricing snapshot + fingerprints let the settlement
// boundary reject a STALE tier/product price before money moves (§16).
model RepresentativePurchase {
  id String @id @default(uuid())

  representativeId String
  representative   Representative      @relation(fields: [representativeId], references: [id])
  userId           String
  user             User                @relation(fields: [userId], references: [id])
  tierId           String?
  tier             RepresentativeTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)
  productId        String
  product          Product             @relation(fields: [productId], references: [id])

  // Loose, unique links to the reused financial rows (no FK relation).
  checkoutSessionId String  @unique
  paymentId         String? @unique
  orderId           String? @unique

  // REPRESENTATIVE_PURCHASE_STATUSES code (non-financial marker).
  status String @default("PENDING")

  // Immutable pricing snapshot frozen at reseller-checkout creation (§16).
  pricingMode         String @default("REPRESENTATIVE") // REPRESENTATIVE_PRICING_MODE
  priceMode           String // REPRESENTATIVE_PRICE_MODES code at purchase time
  retailPriceToman    Int // live Product.priceToman at creation
  basePriceToman      Int // resolved reseller price (before any stackable discount)
  discountAmountToman Int    @default(0)
  finalPriceToman     Int
  tierFingerprint     String // hash of tier identity/version at creation
  priceFingerprint    String // hash of the resolved price inputs at creation

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([representativeId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}
