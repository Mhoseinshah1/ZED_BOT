model Tutorial {
  id           String           @id @default(uuid())
  categoryId   String
  category     TutorialCategory @relation(fields: [categoryId], references: [id])
  title        String
  caption      String?
  description  String?
  displayOrder Int              @default(0)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  media TutorialMedia[]

  @@index([categoryId])
}

model TutorialMedia {
  id             String            @id @default(uuid())
  tutorialId     String
  tutorial       Tutorial          @relation(fields: [tutorialId], references: [id])
  mediaType      TutorialMediaType
  telegramFileId String
  caption        String?
  displayOrder   Int               @default(0)
  createdAt      DateTime          @default(now())

  @@index([tutorialId])
}

// =============================================================================
// Message templates and button texts (Persian by default)
