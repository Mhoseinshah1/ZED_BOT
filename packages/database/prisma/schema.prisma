// =============================================================================
// ZED_BOT database schema (Phase 2)
//
// Conventions
//   - Money amounts are TOMAN stored as Int (fields end in "Toman").
//   - Data volumes are bytes stored as BigInt (fields end in "Bytes").
//   - Telegram IDs are BigInt.
//   - "...ByAdminId" / "...AdminId" audit fields are SOFT references (plain
//     strings, no FK) so audit history survives any admin-row changes;
//     structural ownership uses real relations.
//   - Financial/service history (payments, orders, services, wallet
//     transactions, receipts, referrals, logs) is never hard-deleted;
//     status fields / soft-delete timestamps are used instead.
//   - Orders and services carry snapshot fields so history stays correct
//     when products/panels are renamed or repriced.
//
// See docs/database-schema.md for the full design notes.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Enums
// =============================================================================

// OWNER            = full access
// SELLER           = seller / admin operator
// SUPPORT          = support operator
// RECEIPT_REVIEWER = payment receipt reviewer
enum AdminRole {
  OWNER
  SELLER
  SUPPORT
  RECEIPT_REVIEWER
}

// F = normal user, N = representative type 1, N2 = representative type 2
enum UserGroup {
  F
  N
  N2
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DISABLED
  DELETED
}

enum KycStatus {
  NONE
  APPROVED
  REJECTED
}

enum WalletTransactionType {
  CHARGE
  SPEND
  REFUND
  CASHBACK
  COMMISSION
  MANUAL_ADD
  MANUAL_DEDUCT
  DEBT_ADD
  DEBT_PAYMENT
  DISCOUNT
  SYSTEM_ADJUSTMENT
}

enum WalletTransactionSource {
  USER_PAYMENT
  ORDER
  ADMIN
  REFERRAL
  CASHBACK
  SYSTEM
  REPRESENTATIVE_DEBT
}

enum PanelType {
  MARZBAN
  XUI
}

enum PanelStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  FAILED
}

enum ServiceLocation {
  MULTI_LOCATION
  DEDICATED_LOCATION
  TEST
}

enum RenewalMethod {
  RESET_VOLUME_AND_TIME
  ADD_TIME_AND_VOLUME_TO_NEXT_PERIOD
  RESET_TIME_ADD_PREVIOUS_VOLUME
  RESET_VOLUME_ADD_TIME
  ADD_TIME_KEEP_REMAINING_VOLUME_AS_TOTAL
}

enum UsernamePatternType {
  TELEGRAM_USERNAME_SEQUENCE
  TELEGRAM_ID_RANDOM
  CUSTOM
  CUSTOM_RANDOM
  CUSTOM_TEXT_RANDOM
  CUSTOM_TEXT_SEQUENCE
  TELEGRAM_ID_SEQUENCE
  REPRESENTATIVE_TEXT_SEQUENCE
}

// Service-checkout username selection (feat/service-checkout-username-note): how
// the buyer chose the REMOTE panel account username during checkout. CUSTOM = the
// buyer typed it; RANDOM = an opaque `u_`-prefixed value generated with node
// crypto. This is the ORIGIN of the identity, orthogonal to the panel's
// UsernamePatternType (which only applies when the buyer makes no explicit choice).
enum ServiceUsernameMode {
  CUSTOM
  RANDOM
}

// Durable reservation lifecycle for a buyer-selected service username. The DB is
// the single authority (never an in-memory Set / Redis-only lock / session-only
// flag). HELD = short-TTL hold while the buyer finishes checkout; BOUND = attached
// to a durable CheckoutSession/Order (no HELD TTL — expiry then derives from the
// linked checkout/payment/order state); CONSUMED = a Service was created with this
// username; RELEASED = explicitly given up (username change / abandonment);
// EXPIRED = reclaimed by the bounded cleanup sweep. Only HELD/BOUND/CONSUMED hold
// the global `activeUsernameKey` uniqueness slot; RELEASED/EXPIRED free it.
enum ServiceUsernameReservationStatus {
  HELD
  BOUND
  CONSUMED
  RELEASED
  EXPIRED
}

enum ProductType {
  SERVICE_PRODUCT
  OTHER_PRODUCT
}

enum OtherProductDeliveryType {
  MANUAL_ADMIN
  STOCK_ITEM
}

// Specialized-workflows phase: the admin-selected product kind. Controls the
// creation wizard, inventory format, customer-information collection and
// fulfillment behavior. NEVER inferred from category/product names. Legacy
// rows are backfilled to GENERIC (their behavior is unchanged - the profile
// resolver derives it from the legacy deliveryType/stockEnabled fields).
enum OtherProductKind {
  GENERIC
  APPLE_ID
  AI_ACCOUNT
  TELEGRAM_PREMIUM
  GIFT_CARD
}

// Effective fulfillment behavior. Null on the Product means "derive from the
// legacy fields" (GENERIC compatibility) - the one resolver in
// other-product-profile.service.ts is the single mapping authority.
enum OtherProductFulfillmentProfile {
  MANUAL_DELIVERY
  STOCK_CREDENTIAL
  STOCK_CODE
  PERSONALIZED_SERVICE
}

// How bulk inventory pastes are split into stock items.
enum OtherProductStockParser {
  SINGLE_LINE
  EXPLICIT_SEPARATOR
  EMAIL_BOUNDARY
}

// Pre-settlement customer-input lifecycle (CheckoutCustomerInput.status).
// SUBMITTED never settles payment, never creates orders and never starts
// fulfillment - consumption happens exactly once at settlement time via a
// CAS on consumedByOtherProductOrderId.
enum CheckoutCustomerInputStatus {
  COLLECTING
  SUBMITTED
  CONSUMED
  ABANDONED
  REDACTED
}

// Naming phase: how the OTHER_PRODUCT delivery/order reference is built.
// Order-facing identifiers ONLY - never stock content, never a Service row.
enum OtherProductNamingPolicy {
  ORDER_SHORT_ID
  TELEGRAM_ID
  TELEGRAM_USERNAME_WITH_FALLBACK
  PRODUCT_CODE_AND_ORDER
  CUSTOM_TEMPLATE
}

enum TrafficResetCycle {
  NO_RESET
  DAY
  WEEK
  MONTH
  YEAR
}

enum DiscountType {
  PERCENT
  FIXED_AMOUNT
}

enum DiscountAppliesTo {
  PURCHASE
  RENEWAL
  BOTH
}

// P0 settlement phase: a Payment's LOCAL settlement truth, kept strictly
// separate from the provider outcome (providerStatus). A payment whose
// provider confirmed SUCCESS but whose checkout was already settled by
// ANOTHER payment becomes DUPLICATE_SUCCESS_REVIEW - provider truth is
// never downgraded.
enum PaymentSettlementStatus {
  UNSETTLED
  SETTLED
  DUPLICATE_SUCCESS_REVIEW
}

enum FinancialReconciliationType {
  DUPLICATE_CHECKOUT_PAYMENT
}

enum FinancialReconciliationStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

enum CheckoutStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  FAILED_REFUNDED
  COMPLETED
}

enum CheckoutPurpose {
  WALLET_CHARGE
  ORDER_PAYMENT
  PAY_WITH_WALLET
}

enum OrderType {
  SERVICE_PURCHASE
  SERVICE_RENEWAL
  EXTRA_VOLUME
  EXTRA_TIME
  LOCATION_CHANGE
  OTHER_PRODUCT
}

enum OrderStatus {
  PENDING_PAYMENT
  WAITING_RECEIPT
  PENDING_REVIEW
  PAID
  PROVISIONING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentGatewayType {
  CARD_TO_CARD
  PLISIO
  NOWPAYMENTS
  AGHAYEPARDAKHT
  ZARINPAL
  TELEGRAM_STARS
  CUSTOM
}

enum PaymentStatus {
  PENDING
  PENDING_REVIEW
  PROCESSING
  APPROVED
  REJECTED
  FAILED
  EXPIRED
  CANCELLED
  DELETED
}

enum PaymentPurpose {
  WALLET_CHARGE
  ORDER_PAYMENT
  PAY_WITH_WALLET
  // Telegram Stars recurring service subscriptions (Phase 2). The initial charge
  // enrolls the subscription; recurring charges renew the existing Service. These
  // are NEVER wallet payments and NEVER a wallet top-up.
  SERVICE_SUBSCRIPTION_INITIAL
  SERVICE_SUBSCRIPTION_RECURRING
}

enum StarsPricingMode {
  MANUAL_RATE
  AUTO_RATE_API
}

enum ServiceStatus {
  CREATING
  ACTIVE
  DISABLED
  EXPIRED
  LIMITED
  DELETED
  FAILED
}

// Free-trial phase: how the Service entitlement came to exist. PAID services
// flow through checkout/settlement; FREE_TRIAL services are claim-backed and
// never count toward paid statistics, revenue or referral commissions.
enum ServiceSource {
  PAID
  FREE_TRIAL
  ADMIN_CREATED
}

enum OtherProductOrderStatus {
  PAID
  WAITING_USER_INFO
  WAITING_ADMIN_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
  DELIVERY_CANCELLED_REFUNDED
  DELIVERY_REJECTED_NO_REFUND
  // Specialized-workflows phase: paid stock order with empty inventory -
  // NEVER silently downgraded to generic manual delivery. Completed by the
  // replenishment retry once stock is added.
  AWAITING_STOCK
  // Transient claim window between stock reservation and delivery send.
  STOCK_RESERVED
}

enum ReferralCommissionStatus {
  PENDING
  PAID
  CANCELLED
  // Affiliate-commission phase: a PAID commission whose source order was later
  // refunded/cancelled is REVERSED once its wallet credit is FULLY clawed back.
  REVERSED
  // Financial-safety phase: the source order was refunded but the referrer's
  // wallet lacked enough balance to claw the credit back without going negative
  // (allowNegativeBalance=false). What could be recovered was; the remainder
  // (recoveryOutstandingToman) is an auditable debt collected as funds arrive.
  REVERSAL_PENDING
}

enum SupportMode {
  PRIVATE_CHAT
  TICKET
}

enum SupportTicketStatus {
  OPEN
  ANSWERED // legacy (pre-Phase 32) - the ticket flow uses WAITING_USER
  WAITING_ADMIN
  WAITING_USER
  CLOSED
}

enum SupportMessageSenderType {
  USER
  ADMIN
  SYSTEM
}

enum TutorialMediaType {
  PHOTO
  VIDEO
  DOCUMENT
}

enum BroadcastType {
  SEND
  FORWARD
}

enum BroadcastStatus {
  DRAFT
  CONFIRMING
  RUNNING
  CANCELLED
  COMPLETED
  FAILED
}

enum BroadcastRecipientStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum SystemLogLevel {
  INFO
  WARN
  ERROR
}

enum ActorType {
  SYSTEM
  USER
  ADMIN
  WORKER
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

// =============================================================================
// Admins
// =============================================================================

model Admin {
  id                   String                  @id @default(uuid())
  telegramId           BigInt                  @unique
  username             String?
  firstName            String?
  lastName             String?
  role                 AdminRole
  isActive             Boolean                 @default(true)
  addedByAdminId       String?
  addedByAdmin         Admin?                  @relation("AdminAddedBy", fields: [addedByAdminId], references: [id])
  addedAdmins          Admin[]                 @relation("AdminAddedBy")
  permissions          AdminPermission[]
  supportMessages      SupportMessage[]
  closedSupportTickets SupportTicket[]         @relation("SupportTicketClosedBy")
  // Admin Service Operations: lifecycle/note audit rows this admin performed.
  serviceOperations    AdminServiceOperation[] @relation("AdminServiceOperationActor")
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([role])
}

model AdminPermission {
  id            String   @id @default(uuid())
  adminId       String
  admin         Admin    @relation(fields: [adminId], references: [id])
  permissionKey String
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([adminId, permissionKey])
}

// =============================================================================
// Users
// =============================================================================

model User {
  id           String     @id @default(uuid())
  telegramId   BigInt     @unique
  username     String?
  firstName    String?
  lastName     String?
  phoneNumber  String?
  languageCode String?
  isBot        Boolean    @default(false)
  status       UserStatus @default(ACTIVE)
  group        UserGroup  @default(F)
  adminNote    String?

  // Representative (group N / N2) lifecycle
  representativeSince      DateTime?
  representativeRemovedAt  DateTime?
  representativeDebtToman  Int       @default(0)
  representativeDebtLocked Boolean   @default(false)

  joinedAt   DateTime  @default(now())
  lastSeenAt DateTime?

  // Security / verification
  blockedAt                DateTime?
  blockedByAdminId         String?
  blockReason              String?
  disabledAt               DateTime?
  disabledByAdminId        String?
  isPhoneVerified          Boolean   @default(false)
  phoneVerifiedAt          DateTime?
  phoneVerifiedByAdminId   String?
  kycStatus                KycStatus @default(NONE)
  kycUpdatedAt             DateTime?
  kycUpdatedByAdminId      String?
  termsAcceptedAt          DateTime?
  forceJoinBypass          Boolean   @default(false)
  forceJoinBypassByAdminId String?

  // Referral
  referrerId                       String?
  referrer                         User?     @relation("UserReferrer", fields: [referrerId], references: [id])
  referredUsers                    User[]    @relation("UserReferrer")
  referralCode                     String?   @unique
  referralJoinedAt                 DateTime?
  referralGiftClaimedAt            DateTime?
  totalReferralCount               Int       @default(0)
  totalReferralPurchaseCount       Int       @default(0)
  totalReferralPurchaseAmountToman Int       @default(0)
  totalReferralCommissionToman     Int       @default(0)

  // Wallet totals (authoritative history in WalletTransaction)
  balanceToman             Int     @default(0)
  totalChargedToman        Int     @default(0)
  totalSpentToman          Int     @default(0)
  totalDiscountToman       Int     @default(0)
  totalRefundedToman       Int     @default(0)
  totalManualAddedToman    Int     @default(0)
  totalManualDeductedToman Int     @default(0)
  allowNegativeBalance     Boolean @default(false)

  // Stats
  referralCount            Int @default(0)
  subServiceCount          Int @default(0)
  ordersCount              Int @default(0)
  paidOrdersCount          Int @default(0)
  totalPurchaseAmountToman Int @default(0)
  discountPercent          Int @default(0)
  score                    Int @default(0)

  // Test accounts
  testAccountLimitOverride Int?
  testAccountsCreatedCount Int       @default(0)
  lastTestAccountCreatedAt DateTime?
  testLimitResetAt         DateTime?

  // Trial-entitlement phase: per-user admin overrides for free-trial
  // eligibility. All nullable/additive - existing rows keep today's exact
  // behavior. Revocation blocks FUTURE claims only (existing services and
  // history are untouched); the "denied until" barrier is a temporary
  // admin denial distinct from cooldown; the cooldown override is a hard
  // per-user barrier; "cooldown cleared at" waives the SETTING-computed
  // cooldown for claims created at/before that instant; the default
  // allowance override replaces the global default-policy allowance for
  // this user only (used by the OWNER "set remaining" operation).
  freeTrialRevokedAt                DateTime?
  freeTrialRevokedByAdminId         String?
  freeTrialDeniedUntil              DateTime?
  freeTrialCooldownUntil            DateTime?
  freeTrialCooldownClearedAt        DateTime?
  freeTrialDefaultAllowanceOverride Int?

  // Message preferences
  cronNotificationsEnabled    Boolean @default(true)
  marketingMessagesEnabled    Boolean @default(true)
  supportMessagesEnabled      Boolean @default(true)
  paymentNotificationsEnabled Boolean @default(true)
  serviceNotificationsEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  walletTransactions          WalletTransaction[]
  orders                      Order[]
  payments                    Payment[]
  services                    Service[]
  checkoutSessions            CheckoutSession[]
  discountCodeUsages          DiscountCodeUsage[]
  manualReceipts              ManualReceipt[]
  hiddenPanels                UserHiddenPanel[]
  hiddenPaymentGateways       UserHiddenPaymentGateway[]
  referralsAsReferrer         Referral[]                   @relation("ReferralReferrer")
  referralAsReferred          Referral?                    @relation("ReferralReferred")
  commissionsAsReferrer       ReferralCommission[]         @relation("CommissionReferrer")
  commissionsAsReferred       ReferralCommission[]         @relation("CommissionReferred")
  freeTrialClaims             FreeTrialClaim[]
  freeTrialEntitlements       FreeTrialEntitlement[]
  freeTrialCampaignRows       FreeTrialCampaignRecipient[]
  wheelSpinHistories          WheelSpinHistory[]
  supportTickets              SupportTicket[]
  checkoutCustomerInputs      CheckoutCustomerInput[]
  supportMessages             SupportMessage[]
  broadcastRecipients         BroadcastRecipient[]
  serviceRatings              ServiceRating[]
  serviceEventLogs            ServiceEventLog[]
  otherProductOrders          OtherProductOrder[]
  // Admin Service Operations: admin lifecycle/note audit rows targeting this user.
  adminServiceOperations      AdminServiceOperation[]      @relation("AdminServiceOperationTargetUser")
  // Notification/retention engine (feat/notification-retention-engine).
  automatedNotifications      AutomatedNotification[]
  notificationInteractions    NotificationInteraction[]
  notificationPreference      NotificationPreference?
  // Customer win-back (feat/customer-winback-automation, Phase 3).
  customerRetentionPreference CustomerRetentionPreference?
  // Representative Program (feat/representative-program): the reseller-price
  // program's application history + at most one Representative record + the
  // reseller-priced purchases the user made for their OWN account.
  representative              Representative?              @relation("UserRepresentative")
  representativeApplications  RepresentativeApplication[]
  representativePurchases     RepresentativePurchase[]
  // Service-checkout username selection: this user's buyer-username reservations.
  serviceUsernameReservations ServiceUsernameReservation[]

  @@index([status])
  @@index([group])
  @@index([referrerId])
  @@index([createdAt])
}

// =============================================================================
// Wallet (immutable transaction log)
// =============================================================================

model WalletTransaction {
  id                 String                  @id @default(uuid())
  userId             String
  user               User                    @relation(fields: [userId], references: [id])
  amountToman        Int
  type               WalletTransactionType
  source             WalletTransactionSource
  reason             String?
  relatedOrderId     String?
  relatedOrder       Order?                  @relation("OrderWalletTransactions", fields: [relatedOrderId], references: [id])
  relatedPaymentId   String?
  relatedPayment     Payment?                @relation("PaymentWalletTransactions", fields: [relatedPaymentId], references: [id])
  adminId            String?
  balanceBeforeToman Int
  balanceAfterToman  Int
  createdAt          DateTime                @default(now())

  referralCommissions ReferralCommission[]
  wheelSpins          WheelSpinHistory[]

  @@index([userId])
  @@index([type])
  @@index([relatedOrderId])
  @@index([relatedPaymentId])
  @@index([createdAt])
  // Selective composite for the referral reversal scan's REFUND-driven discovery:
  // finds REFUND rows and their order ids from the index alone (scales with
  // refunds, not the whole ledger).
  @@index([type, relatedOrderId])
}

// =============================================================================
// Panels
// =============================================================================

model Panel {
  id                String        @id @default(uuid())
  type              PanelType
  name              String
  baseUrl           String
  username          String? // Marzban + XUI SESSION_COOKIE mode
  passwordEncrypted String? // Marzban + XUI SESSION_COOKIE mode
  tokenEncrypted    String? // XUI API_TOKEN mode (bearer token, encrypted)
  status            PanelStatus   @default(ACTIVE)
  panelColor        String?
  isVisible         Boolean       @default(true)
  displayOrder      Int           @default(0)
  visibleForGroups  Json? // array of UserGroup values
  renewalMethod     RenewalMethod @default(RESET_VOLUME_AND_TIME)

  // Feature toggles
  showPanel                        Boolean @default(true)
  showFreeTest                     Boolean @default(false)
  renewalEnabled                   Boolean @default(true)
  customServiceForF                Boolean @default(false)
  customServiceForN                Boolean @default(false)
  customServiceForN2               Boolean @default(false)
  panelUserLimitEnabled            Boolean @default(false)
  userLimitEnabled                 Boolean @default(false)
  extraUserPurchaseEnabled         Boolean @default(false)
  sendConfigEnabled                Boolean @default(true)
  happLinkEnabled                  Boolean @default(false)
  configKeyboardEnabled            Boolean @default(false)
  subscriptionLinkEnabled          Boolean @default(true)
  firstConnectionEnabled           Boolean @default(false)
  freeTestFirstConnectionEnabled   Boolean @default(false)
  locationChangeEnabled            Boolean @default(false)
  dedicatedSubscriptionLinkEnabled Boolean @default(false)
  userCanDisableService            Boolean @default(false)
  userCanEnableService             Boolean @default(false)

  // Per-panel pricing
  pricePerExtraGbToman          Int  @default(0)
  pricePerExtraDayToman         Int  @default(0)
  locationChangePriceToman      Int  @default(0)
  extraUserPriceToman           Int  @default(0)
  customServicePricePerGbToman  Int  @default(0)
  customServicePricePerDayToman Int  @default(0)
  customServiceMinGb            Int?
  customServiceMaxGb            Int?
  customServiceMinDays          Int?
  customServiceMaxDays          Int?

  // Free test settings (free-trial phase: testEnabled/testVolumeMb/
  // testDurationMinutes are the authoritative per-panel trial config; the
  // remaining legacy fields stay editable display extras)
  testEnabled                Boolean @default(false)
  testVolumeMb               Int?
  testDurationMinutes        Int?
  testProductName            String?
  testLocation               String?
  testMessageTemplate        String?
  testGuideAfterCreate       String?
  // Free-trial phase additions: optional concurrent-capacity cap, the XUI
  // trial inbound selection (subset of Panel.inboundIds), and whether the
  // cleanup loop disables the remote account after expiry.
  testMaxConcurrentAccounts  Int?
  testInboundIds             Json?
  testAutoDisableAfterExpiry Boolean @default(false)

  // Marzban / XUI provisioning settings
  templateUsername                 String?
  subscriptionDomain               String?
  usernamePatternType              UsernamePatternType @default(TELEGRAM_ID_RANDOM)
  usernameCustomText               String?
  usernameRandomLength             Int?
  usernameSequenceLastNumber       Int                 @default(0)
  representativeUsernamePrefix     String?
  representativeSequenceLastNumber Int                 @default(0)
  inboundTemplateName              String? // Marzban
  resetStrategy                    String? // Marzban
  inboundIds                       Json? // XUI
  protocolSettings                 Json? // XUI + Marzban explicit (template-free) proxy config

  // Provisioning readiness + API variant + auth mode.
  // apiVariant: XUI panels only - "SANAEI" (3X-UI /panel/api family) is the
  //   only supported variant and the default when null. Marzban ignores it.
  // authMode: XUI panels only - "SESSION_COOKIE" (default when null; stock
  //   3X-UI username/password login) or "API_TOKEN" (pre-issued bearer
  //   token from tokenEncrypted, no /login call). Marzban ignores it.
  authMode              String?
  // provisioningReady: result of the last authenticated readiness check
  //   (null = never checked or stale after a config edit; false blocks
  //   selling). Set by the admin panel test, never by reachability alone.
  // capabilitySnapshot: sanitized readiness breakdown + capability list for
  //   the admin UI. Never contains credentials, cookies or tokens.
  apiVariant            String?
  provisioningReady     Boolean?
  lastCapabilityCheckAt DateTime?
  capabilitySnapshot    Json?

  // Capacity
  accountLimitEnabled  Boolean @default(false)
  accountLimitCount    Int?
  createdAccountsCount Int     @default(0)
  activeAccountsCount  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products              Product[]
  services              Service[]
  orders                Order[]
  hiddenForUsers        UserHiddenPanel[]
  freeTrialClaims       FreeTrialClaim[]
  freeTrialEntitlements FreeTrialEntitlement[]
  serviceEventLogs      ServiceEventLog[]
  // Service-checkout username selection: buyer-username reservations on this panel.
  usernameReservations  ServiceUsernameReservation[]

  @@index([status])
  @@index([type])
}

model UserHiddenPanel {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  panelId         String
  panel           Panel    @relation(fields: [panelId], references: [id])
  hiddenByAdminId String?
  createdAt       DateTime @default(now())

  @@unique([userId, panelId])
  @@index([panelId])
}

// =============================================================================
// Products
// =============================================================================

model ProductCategory {
  id           String      @id @default(uuid())
  type         ProductType
  name         String
  displayOrder Int         @default(0)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  products Product[]

  @@index([type])
}

model Product {
  id                 String           @id @default(uuid())
  type               ProductType
  categoryId         String
  category           ProductCategory  @relation(fields: [categoryId], references: [id])
  panelId            String?
  panel              Panel?           @relation(fields: [panelId], references: [id])
  name               String
  displayGroups      Json? // array of UserGroup values
  serviceLocation    ServiceLocation?
  volumeGb           Int?
  durationDays       Int?
  priceToman         Int
  invoiceDescription String?
  isActive           Boolean          @default(true)
  displayOrder       Int              @default(0)

  // SERVICE_PRODUCT fields (trafficResetCycle has no effect on XUI panels)
  trafficResetCycle TrafficResetCycle?
  allLocations      Boolean            @default(false)
  // XUI only: the product's selected SUBSET of the panel's allowed inbound
  // ids (Panel.inboundIds is the allowlist). null/empty = inherit the
  // panel's full allowlist, so existing products keep working unchanged.
  // A selection outside the allowlist makes the product unsellable.
  inboundIds        Json?

  // OTHER_PRODUCT fields (stock implementation lands in a later phase)
  requiredUserInfoEnabled    Boolean                   @default(false)
  requiredUserInfoPromptText String?
  deliveryType               OtherProductDeliveryType?
  stockEnabled               Boolean                   @default(false)
  // Naming phase: delivery-reference policy for OTHER_PRODUCT orders.
  // Null = the ORDER_SHORT_ID default. The template is used only with
  // CUSTOM_TEMPLATE and only supports the safe variable registry.
  otherNamingPolicy          OtherProductNamingPolicy?
  otherNamingTemplate        String?

  // Specialized-workflows phase. Kind defaults to GENERIC (legacy backfill);
  // a null profile/parser means "resolve from the legacy fields above" -
  // behavior mapping lives ONLY in other-product-profile.service.ts.
  otherProductKind                OtherProductKind                @default(GENERIC)
  otherProductFulfillmentProfile  OtherProductFulfillmentProfile?
  otherProductStockParser         OtherProductStockParser?
  // Card-to-card: start the customer-information form right after receipt
  // submission (before admin approval). Collection NEVER settles payment.
  collectInfoBeforeManualApproval Boolean                         @default(false)
  // Structured customer-input form (validated by
  // customer-input-schema.service.ts; stable field keys, Persian labels).
  customerInputSchema             Json?
  // Optional Persian message sent when a personalized service is completed.
  completionMessageTemplate       String?

  // Telegram Stars recurring subscription config (Phase 2). Opt-in per Product;
  // NOT derived from the Toman/Star rate. Only a SERVICE_PRODUCT with
  // durationDays = 30 and a Stars price in 1..10000 may enable it. The version
  // freezes onto each active subscription; a material change bumps it so active
  // subscriptions keep their old terms until the user re-consents.
  telegramStarsSubscriptionEnabled Boolean @default(false)
  telegramStarsSubscriptionPrice   Int?
  telegramStarsSubscriptionVersion Int     @default(1)

  // Representative Program (feat/representative-program): opt-in per Product.
  // Only an active SERVICE_PRODUCT with this flag true may be sold at a
  // representative tier price. Default false, so no existing product is
  // reseller-priced without an explicit OWNER action.
  representativeEligible Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders                      Order[]
  checkoutSessions            CheckoutSession[]
  services                    Service[]
  otherProductOrders          OtherProductOrder[]
  stockItems                  OtherProductStockItem[]
  // Representative Program (feat/representative-program): per-tier reseller
  // prices set for this product + reseller-priced purchases of it.
  representativeProductPrices RepresentativeProductPrice[]
  representativePurchases     RepresentativePurchase[]

  @@index([categoryId])
  @@index([panelId])
  @@index([type])
  @@index([isActive])
}

// =============================================================================
// Discount codes
// =============================================================================

model DiscountCode {
  id                          String            @id @default(uuid())
  code                        String            @unique
  type                        DiscountType
  value                       Int
  totalUsageLimit             Int?
  totalUsedCount              Int               @default(0)
  perUserUsageLimit           Int?
  allowedGroups               Json? // array of UserGroup values
  appliesTo                   DiscountAppliesTo @default(BOTH)
  startsAt                    DateTime?
  expiresAt                   DateTime?
  isActive                    Boolean           @default(true)
  // Representative Program (feat/representative-program): by default a discount
  // code is NOT stackable on top of a representative tier price (reseller
  // pricing already applies). Only a code with this flag true may combine with
  // representative pricing (§7). Retail behaviour is unchanged.
  allowRepresentativeStacking Boolean           @default(false)
  createdByAdminId            String?
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  usages           DiscountCodeUsage[]
  orders           Order[]
  checkoutSessions CheckoutSession[]

  @@index([isActive])
  @@index([expiresAt])
}

model DiscountCodeUsage {
  id                String           @id @default(uuid())
  discountCodeId    String
  discountCode      DiscountCode     @relation(fields: [discountCodeId], references: [id])
  userId            String
  user              User             @relation(fields: [userId], references: [id])
  orderId           String?
  order             Order?           @relation(fields: [orderId], references: [id])
  // P0 settlement phase: a checkout's discount is consumable at most ONCE -
  // DB-enforced (nullable unique; legacy usages without a checkout keep
  // working). Racing claims surface as P2002 and resolve idempotently.
  checkoutSessionId String?          @unique
  checkoutSession   CheckoutSession? @relation(fields: [checkoutSessionId], references: [id])
  amountToman       Int
  createdAt         DateTime         @default(now())

  @@index([discountCodeId])
  @@index([userId])
  @@index([orderId])
}

// =============================================================================
// Checkout (invoice before order - see docs/database-schema.md)
// =============================================================================

model CheckoutSession {
  id                              String          @id @default(uuid())
  userId                          String
  user                            User            @relation(fields: [userId], references: [id])
  purpose                         CheckoutPurpose
  productId                       String?
  product                         Product?        @relation(fields: [productId], references: [id])
  serviceId                       String? // renewal / extra volume / extra time / location change
  service                         Service?        @relation("ServiceCheckoutSessions", fields: [serviceId], references: [id])
  orderType                       OrderType?
  productSnapshot                 Json?
  // Specialized-workflows phase: immutable fulfillment snapshot captured at
  // checkout creation (kind, profile, parser, info requirements, schema,
  // prompt, completion template). Paid checkouts are fulfilled from THIS,
  // never from the mutable live Product row. Null on legacy checkouts - the
  // compatibility resolver derives behavior from productSnapshot + Product.
  otherProductFulfillmentSnapshot Json?
  originalPriceToman              Int             @default(0)
  discountAmountToman             Int             @default(0)
  finalPriceToman                 Int             @default(0)
  discountCodeId                  String?
  discountCode                    DiscountCode?   @relation(fields: [discountCodeId], references: [id])
  status                          CheckoutStatus  @default(PENDING)
  // P0 settlement phase: THE atomic cross-provider settlement claim. The
  // one Payment allowed to create the Order / credit the wallet for this
  // checkout - written by a compare-and-set (settledByPaymentId IS NULL),
  // so two provider successes can never both settle. Unique: one payment
  // can own at most one checkout. Null on legacy/ambiguous rows.
  settledByPaymentId              String?         @unique
  settledByPayment                Payment?        @relation("CheckoutSettledBy", fields: [settledByPaymentId], references: [id])
  expiresAt                       DateTime
  paidAt                          DateTime?
  completedAt                     DateTime?
  createdAt                       DateTime        @default(now())
  updatedAt                       DateTime        @updatedAt

  orders               Order[]
  payments             Payment[]
  discountUsages       DiscountCodeUsage[]
  customerInput        CheckoutCustomerInput?
  // Service-checkout username selection: reservation(s) BOUND to this checkout.
  usernameReservations ServiceUsernameReservation[]

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
}

// =============================================================================
// Orders
// =============================================================================

model Order {
  id                String           @id @default(uuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id])
  // P0 settlement phase: DB-enforced one Order per Checkout (defense in
  // depth under the settledByPaymentId claim). Nullable unique - legacy
  // orders without a checkout are unaffected; racing creates surface as
  // P2002 and are resolved idempotently by re-reading the winner.
  checkoutSessionId String?          @unique
  checkoutSession   CheckoutSession? @relation(fields: [checkoutSessionId], references: [id])
  type              OrderType
  status            OrderStatus      @default(PENDING_PAYMENT)
  productId         String?
  product           Product?         @relation(fields: [productId], references: [id])
  serviceId         String? // target service for renewal / extras
  service           Service?         @relation("ServiceTargetOrders", fields: [serviceId], references: [id])
  paymentId         String? // primary payment that settled this order
  payment           Payment?         @relation("OrderPrimaryPayment", fields: [paymentId], references: [id])
  panelId           String?
  panel             Panel?           @relation(fields: [panelId], references: [id])

  originalPriceToman  Int           @default(0)
  discountAmountToman Int           @default(0)
  finalPriceToman     Int           @default(0)
  discountCodeId      String?
  discountCode        DiscountCode? @relation(fields: [discountCodeId], references: [id])

  // Snapshots - immutable copies of what was sold
  productNameSnapshot        String?
  productDescriptionSnapshot String?
  productPriceSnapshot       Int?
  durationDaysSnapshot       Int?
  volumeGbSnapshot           Int?
  // XUI only: the EXACT inbound ids sold at checkout (resolved from the
  // panel allowlist + product selection when the snapshot was built).
  // Provisioning attaches the global client to THIS set - product/panel
  // edits after payment never change a paid order's entitlement. Null on
  // legacy orders (they resolve from live config at provisioning time).
  inboundIdsSnapshot         Json?
  noteSnapshot               String?
  // Service-checkout username selection (feat/service-checkout-username-note):
  // the buyer's OPTIONAL subscription note, captured while the Telegram session
  // was still alive and frozen here so every payment method (wallet, card,
  // gateway, Stars) provisions from the same immutable text. Null = the buyer
  // skipped the note (or a legacy order predates this feature). This is the
  // buyer-facing note ONLY - never the internal `zedbot order:...` panel marker.
  serviceNoteSnapshot        String?
  panelNameSnapshot          String?
  locationSnapshot           String?
  categorySnapshot           String?
  // Naming phase: the IMMUTABLE identity resolution for this order.
  // SERVICE_PURCHASE: { strategy, version, resolvedRemoteUsername,
  // resolvedDisplayName, sources } persisted exactly once BEFORE the first
  // remote mutation - retries/reconciliation reuse it verbatim; mutable
  // admin/user data can never rename a paid order. Null = legacy order
  // (pre-naming-phase deterministic generator remains its identity).
  namingSnapshot             Json?
  // Naming phase (OTHER_PRODUCT): safe, deterministic user/admin-facing
  // delivery reference - NEVER derived from stock content or secrets and
  // NEVER an authorization mechanism. Null on legacy orders.
  deliveryReference          String?

  rating        Int?
  failureReason String?
  adminNote     String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  paidAt      DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  refundedAt  DateTime?

  payments               Payment[]                    @relation("PaymentOrder")
  walletTransactions     WalletTransaction[]          @relation("OrderWalletTransactions")
  discountUsages         DiscountCodeUsage[]
  createdServices        Service[]                    @relation("OrderCreatedService")
  otherProductOrder      OtherProductOrder?
  referralCommissions    ReferralCommission[]
  firstPurchaseReferrals Referral[]                   @relation("ReferralFirstPurchaseOrder")
  // Service-checkout username selection: reservation(s) BOUND to this order.
  usernameReservations   ServiceUsernameReservation[]

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([productId])
  @@index([serviceId])
  @@index([paymentId])
  @@index([panelId])
  @@index([checkoutSessionId])
  @@index([deliveryReference])
  @@index([createdAt])
}

// =============================================================================
// Payments
// =============================================================================

model PaymentGateway {
  id                                   String             @id @default(uuid())
  type                                 PaymentGatewayType
  name                                 String
  isEnabled                            Boolean            @default(true)
  isHidden                             Boolean            @default(false)
  configEncrypted                      String?
  minAmountToman                       Int?
  maxAmountToman                       Int?
  activateAfterSuccessfulPaymentsCount Int                @default(0)
  allowedGroups                        Json? // array of UserGroup values
  cashbackPercent                      Int                @default(0)
  supportUsername                      String?
  instructionText                      String?
  displayOrder                         Int                @default(0)
  // Provider-management phase: optional admin-facing description plus the
  // last connection-test outcome ("OK"/"FAILED"; never raw provider errors).
  description                          String?
  lastCheckedAt                        DateTime?
  healthStatus                         String?
  createdAt                            DateTime           @default(now())
  updatedAt                            DateTime           @updatedAt

  cardAccounts   CardToCardAccount[]
  payments       Payment[]
  hiddenForUsers UserHiddenPaymentGateway[]

  @@index([type])
  @@index([isEnabled])
}

model CardToCardAccount {
  id                  String         @id @default(uuid())
  gatewayId           String
  gateway             PaymentGateway @relation(fields: [gatewayId], references: [id])
  cardNumberEncrypted String
  ownerName           String
  isActive            Boolean        @default(true)
  displayOrder        Int            @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([gatewayId])
}

model Payment {
  id                    String                  @id @default(uuid())
  userId                String
  user                  User                    @relation(fields: [userId], references: [id])
  orderId               String?
  order                 Order?                  @relation("PaymentOrder", fields: [orderId], references: [id])
  checkoutSessionId     String?
  checkoutSession       CheckoutSession?        @relation(fields: [checkoutSessionId], references: [id])
  gatewayId             String?
  gateway               PaymentGateway?         @relation(fields: [gatewayId], references: [id])
  purpose               PaymentPurpose
  status                PaymentStatus           @default(PENDING)
  amountToman           Int
  payableAmountToman    Int
  // Online gateway fields (payment-gateway-system phase). provider is a
  // denormalized copy of the gateway type so payment rows stay classifiable
  // even if the gateway row changes. authority = the provider handle issued
  // at creation (Zarinpal authority / NOWPayments invoice id / Stars
  // payload nonce) - unique so callbacks resolve exactly one payment.
  // externalReference = the provider-side payment/invoice reference;
  // externalTransactionId = the FINAL settlement reference (Zarinpal ref_id,
  // NOWPayments payment_id, Telegram charge id). providerStatus is the
  // NORMALIZED provider outcome (SUCCESS/PROCESSING/FAILED/EXPIRED/
  // CANCELLED) recorded by verified callbacks/webhooks; money only moves in
  // the bot settlement transaction. callbackPayload stays sanitized:
  // NEVER credentials, signatures, api keys or tokens.
  provider              PaymentGatewayType?
  authority             String?                 @unique
  externalReference     String?
  providerStatus        String?
  verifiedAt            DateTime?
  externalTransactionId String?
  callbackPayload       Json?
  idempotencyKey        String?                 @unique
  // P0 settlement phase: LOCAL settlement truth, separate from the provider
  // outcome. SETTLED = this payment owns its checkout's settlement;
  // DUPLICATE_SUCCESS_REVIEW = provider SUCCESS but another payment owns the
  // checkout (filed as a FinancialReconciliationCase). settlementReason is a
  // short SAFE English marker - never raw provider payloads.
  settlementStatus      PaymentSettlementStatus @default(UNSETTLED)
  settledAt             DateTime?
  settlementReason      String?
  expiresAt             DateTime?
  paidAt                DateTime?
  reviewedAt            DateTime?
  reviewedByAdminId     String?
  rejectReason          String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  receipts           ManualReceipt[]
  walletTransactions WalletTransaction[] @relation("PaymentWalletTransactions")
  primaryForOrders   Order[]             @relation("OrderPrimaryPayment")
  settledCheckout    CheckoutSession?    @relation("CheckoutSettledBy")

  // One external provider transaction can settle at most one local Payment.
  // Provider-scoped: transaction ids are not globally unique across
  // providers. Postgres treats NULLs as distinct, so legacy/pending rows
  // without an external id are unaffected.
  @@unique([provider, externalTransactionId])
  @@index([userId])
  @@index([status])
  @@index([orderId])
  @@index([gatewayId])
  @@index([checkoutSessionId])
  @@index([externalTransactionId])
  @@index([provider, status])
  @@index([externalReference])
  @@index([settlementStatus])
  @@index([createdAt])
}

// P0 settlement phase: persistent financial-review queue. One case per
// duplicate successful Payment (duplicatePaymentId unique - repeated
// settlement attempts converge on the same case). primaryPaymentId is null
// only when a legacy checkout was settled before ownership was recorded.
// safeReason carries a short English marker, never provider payloads.
model FinancialReconciliationCase {
  id     String                        @id @default(uuid())
  type   FinancialReconciliationType
  status FinancialReconciliationStatus @default(OPEN)

  checkoutSessionId  String
  primaryPaymentId   String?
  duplicatePaymentId String  @unique

  userId              String
  expectedAmountToman Int

  safeReason        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  resolvedAt        DateTime?
  resolvedByAdminId String?

  @@index([status, createdAt])
  @@index([checkoutSessionId])
  @@index([primaryPaymentId])
  @@index([userId])
}

model ManualReceipt {
  id                String        @id @default(uuid())
  paymentId         String
  payment           Payment       @relation(fields: [paymentId], references: [id])
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  fileId            String?
  text              String?
  status            PaymentStatus @default(PENDING_REVIEW)
  reviewedByAdminId String?
  reviewedAt        DateTime?
  rejectReason      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([paymentId])
  @@index([userId])
  @@index([status])
}

model UserHiddenPaymentGateway {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  paymentGatewayId String
  paymentGateway   PaymentGateway @relation(fields: [paymentGatewayId], references: [id])
  hiddenByAdminId  String?
  createdAt        DateTime       @default(now())

  @@unique([userId, paymentGatewayId])
  @@index([paymentGatewayId])
}

// Single logical global row, addressed via singletonKey = "default".
model StarsPricingSetting {
  id                            String           @id @default(uuid())
  singletonKey                  String           @unique @default("default")
  pricingMode                   StarsPricingMode @default(MANUAL_RATE)
  manualTomanPerStar            Int?
  currencyRateApiUrl            String?
  currencyRateApiTokenEncrypted String?
  currencyCode                  String?
  starsPriceFormula             String?
  minStars                      Int?
  maxStars                      Int?
  cashbackPercent               Int              @default(0)
  createdAt                     DateTime         @default(now())
  updatedAt                     DateTime         @updatedAt
}

// =============================================================================
// Services (provisioned VPN accounts)
// =============================================================================

model Service {
  id                     String        @id @default(uuid())
  userId                 String
  user                   User          @relation(fields: [userId], references: [id])
  orderId                String? // order that created this service
  order                  Order?        @relation("OrderCreatedService", fields: [orderId], references: [id])
  panelId                String
  panel                  Panel         @relation(fields: [panelId], references: [id])
  productId              String?
  product                Product?      @relation(fields: [productId], references: [id])
  panelType              PanelType // snapshot of the panel type at creation
  username               String        @unique
  note                   String?
  // Service-checkout username selection (feat/service-checkout-username-note):
  // the buyer's OPTIONAL subscription note, copied verbatim from
  // Order.serviceNoteSnapshot at provisioning. Null = the buyer skipped it (or a
  // legacy service predates this feature). This is buyer-facing and rendered
  // (HTML-escaped) on the service detail page; it is NEVER the internal `note`
  // marker above and is NEVER pushed to the remote panel.
  userNote               String?
  // Naming phase: how `username` (the REMOTE technical identity) was
  // resolved - { strategy, version, resolvedRemoteUsername,
  // resolvedDisplayName }. Null = LEGACY (created before the naming phase);
  // lifecycle operations always use the stored `username`, never recompute.
  namingStrategySnapshot Json?
  status                 ServiceStatus @default(CREATING)
  // Free-trial phase: entitlement origin (PAID default keeps history intact).
  source                 ServiceSource @default(PAID)

  serviceLocation ServiceLocation @default(MULTI_LOCATION)

  // Trial-lifecycle phase: trial-to-paid conversion markers. `source` is
  // the immutable ORIGIN and is never overwritten; the FIRST verified,
  // completed paid operation (renewal / extra volume / extra time) on a
  // FREE_TRIAL service stamps these exactly once (CAS on
  // convertedToPaidAt IS NULL). Conversion never restores trial allowance
  // and never re-enables another trial. firstPaidOrderId is a soft
  // reference (plain id, no FK) like other *_OrderId audit fields.
  convertedToPaidAt DateTime?
  firstPaidOrderId  String?

  // Snapshots
  productNameSnapshot String?
  panelNameSnapshot   String?

  volumeBytes    BigInt @default(0)
  usedBytes      BigInt @default(0)
  remainingBytes BigInt @default(0)
  durationDays   Int    @default(0)

  startsAt                 DateTime  @default(now())
  // Nullable: services with unlimited time (durationDays = 0) never expire.
  expiresAt                DateTime?
  firstConnectedAt         DateTime?
  lastConnectedAt          DateTime?
  lastSubscriptionUpdateAt DateTime?
  subscriptionUrl          String?
  subscriptionToken        String?
  configLinks              Json?
  qrCodeFileId             String?
  userAgent                String?
  rating                   Int?
  transferredFromUserId    String?
  transferredAt            DateTime?
  deletedAt                DateTime?
  panelDeletedAt           DateTime?
  failureReason            String?

  // Remote client identifiers for panels that address clients rather than
  // usernames (XUI). remoteClientId is the primary client identifier (UUID
  // for VLESS/VMess, password for Trojan) - sensitive like
  // subscriptionToken, stored but never logged. remoteInboundIds = inbound
  // ids the client was added to. remoteMetadata = non-secret structured
  // identifiers (client emails, subscription id).
  remoteClientId   String?
  remoteInboundIds Json?
  remoteMetadata   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ratings                ServiceRating[]
  eventLogs              ServiceEventLog[]
  relatedOrders          Order[]                        @relation("ServiceTargetOrders")
  checkoutSessions       CheckoutSession[]              @relation("ServiceCheckoutSessions")
  freeTrialClaims        FreeTrialClaim[]
  // Notification/retention engine: optional per-service notification prefs.
  notificationPreference ServiceNotificationPreference?
  // Service self-diagnostics: tickets opened from a diagnostic run on this
  // service (owner-scoped link; snapshot lives on the ticket).
  supportTickets         SupportTicket[]                @relation("ServiceSupportTickets")
  // Admin Service Operations: durable admin lifecycle/note audit rows.
  adminOperations        AdminServiceOperation[]
  // Service-checkout username selection: the reservation that this Service
  // CONSUMED (at most one; the reservation's serviceId is unique).
  usernameReservation    ServiceUsernameReservation?

  @@index([userId])
  @@index([panelId])
  @@index([productId])
  @@index([orderId])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
  // Trial-lifecycle phase: converted-trial metrics and admin lists.
  @@index([source, convertedToPaidAt])
}

model ServiceRating {
  id        String   @id @default(uuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([serviceId])
  @@index([userId])
}

model ServiceEventLog {
  id        String   @id @default(uuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  panelId   String
  panel     Panel    @relation(fields: [panelId], references: [id])
  eventType String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([serviceId])
  @@index([userId])
  @@index([panelId])
  @@index([eventType])
  @@index([createdAt])
}

// Service-checkout username selection (feat/service-checkout-username-note). The
// DURABLE, DB-authoritative reservation of a buyer-selected REMOTE panel username
// held from selection through provisioning. It is the ONLY authority for the
// "one active reservation per username" invariant — never an in-memory Set, a
// Redis-only lock, or Telegram-session state.
//
// `normalizedUsername` is the lower-cased, validated username (kept for audit /
// display / lookup in EVERY state). `activeUsernameKey` mirrors it ONLY while the
// reservation is HELD/BOUND/CONSUMED and is set to NULL on RELEASED/EXPIRED; the
// GLOBAL `activeUsernameKey @unique` constraint (NULLs are distinct in Postgres)
// is therefore a FILTERED uniqueness that lets a freed username be re-reserved
// while still forbidding two live holders — a check-then-insert race surfaces as
// P2002, resolved by re-reading the winner. This mirrors Service.username's own
// GLOBAL uniqueness, so an active hold blocks the same username on every panel and
// no cross-panel provisioning collision can slip through. `panelId` is retained
// for remote availability + provisioning routing (never for uniqueness).
//
// Lifecycle transitions are CAS (updateMany with a status guard), so concurrent
// settlement / cleanup / change-username paths converge deterministically:
//   HELD ──bind──▶ BOUND ──consume──▶ CONSUMED
//     │              │
//     └── release/expire ─┴──▶ RELEASED / EXPIRED
// Changing username atomically INSERTs the new active row before RELEASE-ing the
// old one, so the buyer never loses their hold on a P2002.
model ServiceUsernameReservation {
  id                 String                           @id @default(uuid())
  panelId            String
  panel              Panel                            @relation(fields: [panelId], references: [id])
  userId             String
  user               User                             @relation(fields: [userId], references: [id])
  // The validated, lower-cased username. Retained in every state for audit.
  normalizedUsername String
  // Mirrors normalizedUsername while HELD/BOUND/CONSUMED; NULL once RELEASED or
  // EXPIRED so the slot is freed for re-use. GLOBALLY unique while non-null
  // (feat hotfix: matches Service.username's global uniqueness — an active hold
  // for a username on one panel now blocks the SAME username on every panel,
  // closing the cross-panel provisioning-collision gap). NULLs stay distinct in
  // Postgres, so any number of RELEASED/EXPIRED rows may share NULL.
  activeUsernameKey  String?                          @unique
  mode               ServiceUsernameMode
  status             ServiceUsernameReservationStatus @default(HELD)
  // The checkout draft nonce that created/refreshed this hold. Same
  // (userId, draftNonce) idempotently reuses the existing row instead of
  // stacking duplicate holds.
  draftNonce         String?
  // Durable links, populated as the reservation advances. A BOUND reservation is
  // protected from HELD-TTL expiry precisely because these point at live rows;
  // the cleanup sweep consults the linked checkout/payment/order/service state.
  checkoutSessionId  String?
  checkoutSession    CheckoutSession?                 @relation(fields: [checkoutSessionId], references: [id])
  orderId            String?
  order              Order?                           @relation(fields: [orderId], references: [id])
  serviceId          String?                          @unique
  service            Service?                         @relation(fields: [serviceId], references: [id])
  // Short HELD-state TTL. Null once BOUND (BOUND expiry derives from the linked
  // durable state, never this timestamp).
  expiresAt          DateTime?
  boundAt            DateTime?
  consumedAt         DateTime?
  releasedAt         DateTime?
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt

  @@index([userId])
  @@index([panelId])
  @@index([status])
  @@index([normalizedUsername])
  @@index([checkoutSessionId])
  @@index([orderId])
  @@index([expiresAt])
  @@index([userId, draftNonce])
}

// Admin Service Operations (feat/admin-service-operations). The DURABLE audit +
// reconciliation authority for every per-Service admin lifecycle action and
// internal note. SystemLog is supplemental. Relations are nullable with
// onDelete: SetNull so the audit row survives Service/User/Admin removal (the id
// nulls, the operation history stays). Snapshots are the SAFE shape from
// @zedbot/shared (AdminServiceStateSnapshot) — NO secret (subscription URL,
// config link, Panel URL/credentials, token, remote client id, raw response) is
// ever persisted here; `reason` is bounded plain internal text; idempotencyKey
// is derived only from non-secret identifiers; sourceUpdateId is the inbound
// Telegram update_id for replay protection. Rows are never physically deleted
// through the UI.
model AdminServiceOperation {
  id           String   @id @default(uuid())
  serviceId    String?
  service      Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  targetUserId String?
  targetUser   User?    @relation("AdminServiceOperationTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  adminId      String?
  admin        Admin?   @relation("AdminServiceOperationActor", fields: [adminId], references: [id], onDelete: SetNull)

  type   String // AdminServiceOperationType code (@zedbot/shared)
  status String // AdminServiceOperationStatus code (@zedbot/shared)
  reason String // bounded plain internal text (mutation reason / note body)

  requestedValue BigInt? // GiB→bytes or day count (typed by requestedUnit)
  requestedUnit  String? // "GIB" | "DAY"
  notifyUser     Boolean @default(true)

  idempotencyKey        String  @unique // non-secret derived key; converges double-clicks
  sourceUpdateId        BigInt? @unique // inbound Telegram update_id; replay protection
  confirmationNonceHash String? // hash of the one-shot confirmation nonce

  beforeSnapshot Json // AdminServiceStateSnapshot (safe fields only)
  afterSnapshot  Json? // AdminServiceStateSnapshot after a definite success
  safeErrorCode  String? // AdminServiceErrorCode (never a raw error)

  startedAt           DateTime?
  completedAt         DateTime?
  userNotifiedAt      DateTime?
  reconciledAt        DateTime?
  reconciledByAdminId String? // soft admin reference (audit survives admin change)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceId, createdAt])
  @@index([adminId, createdAt])
  @@index([status, createdAt])
  @@index([type, createdAt])
}

// =============================================================================
// Other products (non-VPN digital products)
// =============================================================================

model OtherProductOrder {
  id        String                  @id @default(uuid())
  orderId   String                  @unique
  order     Order                   @relation(fields: [orderId], references: [id])
  userId    String
  user      User                    @relation(fields: [userId], references: [id])
  productId String
  product   Product                 @relation(fields: [productId], references: [id])
  status    OtherProductOrderStatus

  userProvidedInfoText String?
  userProvidedFiles    Json?
  adminDeliveryText    String?
  adminDeliveryFiles   Json?
  deliveredByAdminId   String?
  deliveredAt          DateTime?
  adminRejectReason    String?
  adminCancelReason    String?

  userInfoReminderCount  Int       @default(0)
  lastUserInfoReminderAt DateTime?

  // Specialized-workflows phase: immutable per-order copies (from the
  // checkout fulfillment snapshot) + encrypted structured customer input.
  // Legacy plaintext userProvidedInfoText stays for old rows; NEW structured
  // submissions live in customerInputEncrypted (AES-256-GCM, APP_SECRET)
  // with only a masked safe summary alongside.
  kindSnapshot                OtherProductKind?
  fulfillmentProfileSnapshot  OtherProductFulfillmentProfile?
  customerInputSchemaSnapshot Json?
  customerInputEncrypted      String?
  customerInputSummary        String?
  customerInputSubmittedAt    DateTime?
  completionMessageSnapshot   String?
  // Exactly-once fulfillment-admin notification (CAS on NULL).
  fulfillmentAdminsNotifiedAt DateTime?
  awaitingStockSince          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerInput CheckoutCustomerInput?

  @@index([userId])
  @@index([productId])
  @@index([status])
}

// Specialized-workflows phase: pre-settlement customer input scoped to ONE
// checkout of ONE user. Collected right after a card-to-card receipt is
// submitted (before approval) or after automatic settlement. Submission is
// NEVER a financial event: it cannot settle payments, create orders, start
// fulfillment, consume stock or notify fulfillment admins. Values are
// encrypted at rest; renderedSafeSummary is the ONLY display copy (masked,
// password fields never rendered in full). Consumption is exactly-once via
// the unique consumedByOtherProductOrderId CAS; rejected/expired rows are
// redacted by the retention sweep (valuesEncrypted cleared, status REDACTED).
model CheckoutCustomerInput {
  id                            String                      @id @default(uuid())
  checkoutSessionId             String                      @unique
  checkoutSession               CheckoutSession             @relation(fields: [checkoutSessionId], references: [id])
  userId                        String
  user                          User                        @relation(fields: [userId], references: [id])
  schemaSnapshot                Json
  valuesEncrypted               String?
  renderedSafeSummary           String?
  status                        CheckoutCustomerInputStatus @default(COLLECTING)
  submittedAt                   DateTime?
  consumedByOtherProductOrderId String?                     @unique
  consumedByOtherProductOrder   OtherProductOrder?          @relation(fields: [consumedByOtherProductOrderId], references: [id])
  consumedAt                    DateTime?
  redactedAt                    DateTime?
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt

  @@index([userId])
  @@index([status, updatedAt])
}

enum StockItemStatus {
  AVAILABLE
  RESERVED
  DELIVERED
  DISABLED
}

// Phase 25: encrypted stock inventory for auto-delivered OTHER_PRODUCTs.
// contentEncrypted is AES-256-GCM (APP_SECRET) - raw content is never
// logged and only the buying user sees it decrypted, on delivery.
model OtherProductStockItem {
  id        String          @id @default(uuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  status    StockItemStatus @default(AVAILABLE)

  contentEncrypted   String
  label              String?
  // Specialized-workflows phase: deterministic keyed hash (HMAC-SHA256,
  // APP_SECRET-derived key) of the normalized plaintext so duplicate
  // inventory can be detected per product WITHOUT decrypting, logging or
  // exposing content. Null on legacy rows (random-IV ciphertext cannot be
  // fingerprinted retroactively without a rewrite).
  contentFingerprint String?
  deliveredOrderId   String?   @unique
  deliveredToUserId  String?
  deliveredAt        DateTime?
  disabledAt         DateTime?
  createdByAdminId   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // DB-authoritative delivery correctness: deliveredOrderId is UNIQUE, so a
  // stock item reaches at most one order AND an order receives at most one
  // item (each order id can appear on at most one row).
  @@unique([productId, contentFingerprint])
  @@index([productId])
  @@index([status])
  @@index([createdAt])
}

// =============================================================================
// Referrals
// =============================================================================

model Referral {
  id                         String    @id @default(uuid())
  referrerUserId             String
  referrer                   User      @relation("ReferralReferrer", fields: [referrerUserId], references: [id])
  referredUserId             String    @unique
  referred                   User      @relation("ReferralReferred", fields: [referredUserId], references: [id])
  joinedAt                   DateTime  @default(now())
  firstPurchaseAt            DateTime?
  firstPurchaseOrderId       String?
  firstPurchaseOrder         Order?    @relation("ReferralFirstPurchaseOrder", fields: [firstPurchaseOrderId], references: [id])
  totalPurchaseAmountToman   Int       @default(0)
  totalCommissionAmountToman Int       @default(0)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  commissions ReferralCommission[]

  @@index([referrerUserId])
}

model ReferralCommission {
  id                          String                   @id @default(uuid())
  referralId                  String
  referral                    Referral                 @relation(fields: [referralId], references: [id])
  referrerUserId              String
  referrer                    User                     @relation("CommissionReferrer", fields: [referrerUserId], references: [id])
  referredUserId              String
  referred                    User                     @relation("CommissionReferred", fields: [referredUserId], references: [id])
  orderId                     String
  order                       Order                    @relation(fields: [orderId], references: [id])
  amountToman                 Int
  percent                     Int
  status                      ReferralCommissionStatus @default(PENDING)
  walletTransactionId         String?
  walletTransaction           WalletTransaction?       @relation(fields: [walletTransactionId], references: [id])
  // Set to the FIRST clawback debit when a reversal begins. The full recovery
  // audit trail is the WalletTransaction rows (type SYSTEM_ADJUSTMENT, source
  // REFERRAL, relatedOrderId) — a single FK cannot hold multiple partial debits.
  reversalWalletTransactionId String?
  // Financial-safety phase — no-overdraft clawback accounting:
  //   recoveredToman           = amount actually clawed back so far (sum of debits)
  //   recoveryOutstandingToman = amount still owed (amountToman − recoveredToman)
  // While REVERSAL_PENDING the outstanding is collected as the referrer's wallet
  // gains funds; when it reaches 0 the commission becomes REVERSED. A CHECK keeps
  // 0 <= recovered <= amount so a debt can never be over-collected.
  recoveredToman              Int                      @default(0)
  recoveryOutstandingToman    Int                      @default(0)
  // When the reversal was first detected/initiated (a refunded source order).
  reversalRequestedAt         DateTime?
  createdAt                   DateTime                 @default(now())
  paidAt                      DateTime?
  reversedAt                  DateTime?

  // Idempotency: at most ONE commission row per source order, so a re-fired
  // order-completion hook / concurrent settlement can never pay twice.
  @@unique([orderId])
  @@index([referralId])
  @@index([referrerUserId])
  @@index([referredUserId])
  @@index([status])
}

// =============================================================================
// Free test accounts / lucky wheel
// =============================================================================

// Free-trial phase: lifecycle of one free-trial entitlement. Migrated from
// the unused TestAccountHistory placeholder (table renamed in place). The
// claim - NOT a Payment/Order - is the entitlement record: it is created
// atomically (partial unique index on userId over in-progress/active
// statuses, see migration SQL) and drives provisioning, reconciliation and
// expiry. FAILED/CANCELLED rows never block a retry; lifetime/cooldown
// policy over EXPIRED rows is enforced transactionally in the service.
enum FreeTrialClaimStatus {
  CLAIMED
  PROVISIONING
  ACTIVE
  FAILED
  EXPIRED
  CANCELLED
  MANUAL_REVIEW
}

model FreeTrialClaim {
  id        String               @id @default(uuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id])
  panelId   String
  panel     Panel                @relation(fields: [panelId], references: [id])
  serviceId String?
  service   Service?             @relation(fields: [serviceId], references: [id])
  status    FreeTrialClaimStatus @default(CLAIMED)

  // Trial-entitlement phase: which allowance funded this claim. Null =
  // the default policy allowance (counted from unlinked claims - default
  // units are never materialized as rows). The reservation is made in the
  // SAME transaction that creates the claim; a retry reuses the claim and
  // therefore the same reservation.
  entitlementId       String?
  entitlement         FreeTrialEntitlement? @relation(fields: [entitlementId], references: [id])
  // Release-exactly-once marker: stamped by the ONE place that returns
  // this claim's allowance unit (definite non-creation / NOT_APPLIED /
  // forced not-created). UNKNOWN outcomes never stamp it. The CAS on
  // "allowanceReleasedAt IS NULL" is what makes release idempotent.
  allowanceReleasedAt DateTime?

  // Frozen at claim time so retries/reconciliation reuse the SAME identity.
  usernameSnapshot String?
  namingSnapshot   Json?
  durationMinutes  Int?
  trafficBytes     BigInt?

  provisionedAt     DateTime?
  expiresAt         DateTime?
  // Short SAFE English marker - never raw provider/panel data.
  failureReasonCode String?
  attemptCount      Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([panelId])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([entitlementId])
}

// Trial-entitlement phase: an explicit, auditable PERMISSION for one or
// more trial claims - separate from FreeTrialClaim (one actual
// request/provisioning attempt). The default policy allowance is NEVER
// materialized as rows; entitlement rows exist only for admin grants,
// resets, campaign grants, compensations and migrations. Historical rows
// are never deleted: they expire (worker/deterministic evaluation) or are
// revoked, and their consumed units stay linked to the claims they funded.
// DB CHECK constraints (allowance >= 0, consumed >= 0,
// consumed <= allowance) live in migration SQL - Prisma cannot express
// them - and are the authoritative overdraw guard.
enum FreeTrialEntitlementScope {
  GLOBAL
  PANEL
}

enum FreeTrialEntitlementSource {
  DEFAULT_POLICY
  ADMIN_GRANT
  ADMIN_RESET
  CAMPAIGN_RESET
  COMPENSATION
  MIGRATION
}

enum FreeTrialEntitlementStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  REVOKED
}

model FreeTrialEntitlement {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  allowance Int
  consumed  Int @default(0)

  scope   FreeTrialEntitlementScope @default(GLOBAL)
  panelId String?
  panel   Panel?                    @relation(fields: [panelId], references: [id])

  source FreeTrialEntitlementSource
  status FreeTrialEntitlementStatus @default(ACTIVE)

  startsAt  DateTime?
  expiresAt DateTime?

  // Admin-provided reason (required for grants/resets/revocations) -
  // internal, never shown to the user.
  reason           String?
  createdByAdminId String?
  revokedAt        DateTime?
  revokedByAdminId String?

  campaignId String?
  campaign   FreeTrialResetCampaign? @relation(fields: [campaignId], references: [id])

  // Explicit idempotency key for the operation that created this row
  // (trial-grant:<nonce> / trial-reset:<nonce> / trial-campaign:<cid>:<uid>)
  // - a replayed confirmation or retried campaign job collides here and
  // reuses the existing grant instead of creating a second one.
  idempotencyKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claims FreeTrialClaim[]

  // One grant per campaign per user - the campaign idempotency guard
  // (NULL campaignId rows are exempt: Postgres treats NULLs as distinct).
  @@unique([campaignId, userId])
  @@index([userId, status])
  @@index([panelId])
  @@index([expiresAt])
  @@index([campaignId])
}

// Trial-entitlement phase: a persistent bulk reset/grant campaign. The
// campaign + its recipient snapshot rows ARE the durable queue: the
// in-bot campaign loop (free-trial-entitlement-campaign) processes
// PENDING recipients in small batches, so a restart resumes exactly where
// it stopped and cancellation stops unprocessed grants while preserving
// completed ones. Mirrors the proven Broadcast/BroadcastRecipient pattern.
enum FreeTrialResetCampaignStatus {
  DRAFT
  PREVIEWED
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum FreeTrialCampaignRecipientStatus {
  PENDING
  GRANTED
  SKIPPED
  FAILED
}

model FreeTrialResetCampaign {
  id     String                       @id @default(uuid())
  status FreeTrialResetCampaignStatus @default(DRAFT)

  allowance Int
  // Typed, validated audience descriptor {kind, ...params} - never raw SQL.
  audience  Json
  reason    String
  // Optional expiry applied to every granted entitlement.
  expiresAt DateTime?

  notifyUsers               Boolean @default(false)
  // OWNER decision: also grant users who still have unused allowance.
  includeUsersWithAllowance Boolean @default(false)

  createdByAdminId String

  estimatedUsers Int?
  totalUsers     Int?
  processedUsers Int  @default(0)
  grantedUsers   Int  @default(0)
  skippedUsers   Int  @default(0)
  failedUsers    Int  @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  entitlements FreeTrialEntitlement[]
  recipients   FreeTrialCampaignRecipient[]

  @@index([status, createdAt])
}

model FreeTrialCampaignRecipient {
  id         String                 @id @default(uuid())
  campaignId String
  campaign   FreeTrialResetCampaign @relation(fields: [campaignId], references: [id])
  userId     String
  user       User                   @relation(fields: [userId], references: [id])

  status FreeTrialCampaignRecipientStatus @default(PENDING)

  // Short safe English marker (skip/error classification) - never secrets.
  skipReason    String?
  errorMessage  String?
  entitlementId String?
  processedAt   DateTime?
  notifiedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // At-most-one row per campaign/user: the snapshot is stable and the
  // batch worker can retry without ever double-granting.
  @@unique([campaignId, userId])
  @@index([campaignId, status])
  @@index([userId])
}

model WheelSpinHistory {
  id                  String             @id @default(uuid())
  userId              String
  user                User               @relation(fields: [userId], references: [id])
  diceValue           Int
  isWinner            Boolean            @default(false)
  prizeAmountToman    Int                @default(0)
  walletTransactionId String?
  walletTransaction   WalletTransaction? @relation(fields: [walletTransactionId], references: [id])
  createdAt           DateTime           @default(now())

  @@index([userId])
  @@index([createdAt])
}

// =============================================================================
// Support (schema only - UI uses PRIVATE_CHAT mode for now)
// =============================================================================

model SupportTicket {
  id              String              @id @default(uuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id])
  status          SupportTicketStatus @default(OPEN)
  subject         String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  closedAt        DateTime?
  // Phase 32: which admin closed the ticket.
  closedByAdminId String?
  closedByAdmin   Admin?              @relation("SupportTicketClosedBy", fields: [closedByAdminId], references: [id])

  // Service self-diagnostics (feat/service-self-diagnostics): a ticket the user
  // opened FROM a diagnostic run keeps an OWNER-scoped link to the Service plus a
  // STRICT, bounded, secret-free snapshot of that run (version/overall/evidence/
  // checkedAt + stable check codes/statuses + selected primary recommendation).
  // The snapshot NEVER holds a subscription URL, config, token, remote client id,
  // panel credential, raw panel body or any free-form text (validated before
  // persistence in @zedbot/shared validateDiagnosticSnapshot). Both fields are
  // additive + nullable: every existing ticket keeps serviceId = null and
  // diagnosticSnapshot = null. SetNull keeps a ticket auditable if its Service is
  // ever removed.
  serviceId          String?
  service            Service? @relation("ServiceSupportTickets", fields: [serviceId], references: [id], onDelete: SetNull)
  diagnosticSnapshot Json?

  // Support Tickets V2 (feat/support-ticket-attachments-service-context): a
  // structured category + the origin the ticket was opened from. Both additive +
  // nullable, so every existing ticket keeps category = null / origin = null.
  // Values are STABLE machine codes from @zedbot/shared (SUPPORT_TICKET_CATEGORIES
  // / SUPPORT_TICKET_ORIGINS); Persian rendering maps off these — behaviour never
  // depends on the displayed label.
  category String?
  origin   String?

  messages SupportMessage[]

  @@index([userId])
  @@index([status])
  @@index([userId, updatedAt])
  @@index([status, updatedAt])
  @@index([serviceId])
  @@index([category, updatedAt])
}

model SupportMessage {
  id            String                   @id @default(uuid())
  ticketId      String
  ticket        SupportTicket            @relation(fields: [ticketId], references: [id])
  senderType    SupportMessageSenderType
  senderUserId  String?
  senderUser    User?                    @relation(fields: [senderUserId], references: [id])
  senderAdminId String?
  senderAdmin   Admin?                   @relation(fields: [senderAdminId], references: [id])
  text          String?
  fileId        String?
  createdAt     DateTime                 @default(now())

  // Support Tickets V2: ONE optional attachment per message, stored as Telegram
  // file REFERENCES only — never file bytes, never a download URL, never external
  // object storage. `attachmentType` is a stable code (SUPPORT_ATTACHMENT_TYPES).
  // The Telegram-supplied `fileName` / `mimeType` are UNTRUSTED hints, validated +
  // sanitized before persistence. All additive + nullable, so every existing
  // message (including the many with fileId = null) stays valid.
  attachmentType  String?
  fileUniqueId    String?
  fileName        String?
  mimeType        String?
  fileSizeBytes   BigInt?
  // The inbound Telegram update_id, for idempotent processing: a duplicate
  // delivery (same update_id) can never create a second ticket/message. Nullable
  // (older rows + internally-generated SYSTEM messages carry null) and UNIQUE.
  sourceUpdateId  BigInt? @unique
  // The inbound Telegram message_id (operational audit only; not an idempotency key).
  sourceMessageId Int?

  @@index([ticketId])
  @@index([createdAt])
  @@index([ticketId, createdAt])
}

