#!/usr/bin/env bash
# =============================================================================
# ZED_BOT server management CLI.
# Installed to /usr/local/bin/zedbot by scripts/install.sh.
# =============================================================================

set -Eeuo pipefail

ZEDBOT_APP_DIR="${ZEDBOT_APP_DIR:-/opt/zedbot/app}"
SCRIPTS_DIR="${ZEDBOT_APP_DIR}/scripts"
COMMON_LIB="${SCRIPTS_DIR}/lib/common.sh"

if [ ! -f "$COMMON_LIB" ]; then
  echo "[FAIL] ZED_BOT does not look installed (missing ${COMMON_LIB})." >&2
  echo "       Install it with:" >&2
  echo "       bash <(curl -Ls https://raw.githubusercontent.com/Mhoseinshah1/ZED_BOT/main/scripts/install.sh)" >&2
  exit 1
fi
# shellcheck source=lib/common.sh
. "$COMMON_LIB"

usage() {
  cat <<'EOF'
ZED_BOT management CLI

Usage: zedbot <command> [arguments]

Commands:
  status                  Show the status of all services
  logs [service]          Tail logs (all services, or one of: api, bot, worker, postgres, redis)
  restart                 Restart all services
  start                   Start all services
  stop                    Stop all services
  update                  Update ZED_BOT to the latest version (creates a backup first)
  backup                  Create a backup (.env + PostgreSQL dump)
  restore <backup-file>   Restore from a backup archive
  doctor                  Run system health checks
  uninstall               Remove ZED_BOT from this server
  help                    Show this help

Examples:
  zedbot status
  zedbot logs api
  zedbot restore /opt/zedbot/backups/zedbot-backup-20260101-120000.tar.gz
EOF
}

main() {
  local cmd="${1:-help}"
  shift || true

  case "$cmd" in
    status)
      require_root
      run_compose ps
      ;;
    logs)
      require_root
      run_compose logs --tail=200 -f "$@"
      ;;
    restart)
      require_root
      # `compose restart` never re-reads .env; recreating the containers does,
      # so configuration edits actually take effect (README documents
      # `zedbot restart` as the way to apply .env changes).
      run_compose up -d --force-recreate --remove-orphans
      log_success "All services restarted."
      ;;
    start)
      require_root
      run_compose up -d
      log_success "All services started."
      ;;
    stop)
      require_root
      run_compose stop
      log_success "All services stopped."
      ;;
    update)
      exec bash "${SCRIPTS_DIR}/update.sh" "$@"
      ;;
    backup)
      exec bash "${SCRIPTS_DIR}/backup.sh" "$@"
      ;;
    restore)
      exec bash "${SCRIPTS_DIR}/restore.sh" "$@"
      ;;
    doctor)
      exec bash "${SCRIPTS_DIR}/doctor.sh" "$@"
      ;;
    uninstall)
      exec bash "${SCRIPTS_DIR}/uninstall.sh" "$@"
      ;;
    help | --help | -h)
      usage
      ;;
    *)
      log_error "Unknown command: ${cmd}"
      echo
      usage
      exit 1
      ;;
  esac
}

main "$@"
