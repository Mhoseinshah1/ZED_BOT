# =============================================================================
# ZED_BOT environment configuration (example)
#
# scripts/install.sh generates the real .env interactively. To configure by
# hand instead: copy this file to .env, fill in the values and run
#   chmod 600 .env
# Never commit the real .env - it contains credentials.
# =============================================================================

# --- Application ---
NODE_ENV=production
APP_NAME=ZED_BOT
# Domain name of this server (IP addresses are not supported)
APP_DOMAIN=
# Public base URL, normally https://<APP_DOMAIN>
APP_BASE_URL=
API_PORT=3000
# debug | info | warn | error
LOG_LEVEL=info

# --- SSL (reverse proxy / certificates land in a later phase) ---
# Email used for SSL certificates; defaults to admin@<APP_DOMAIN>
SSL_EMAIL=

# --- Telegram ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs with admin access
ADMIN_TELEGRAM_IDS=

# --- PostgreSQL ---
POSTGRES_DB=zedbot
POSTGRES_USER=zedbot
POSTGRES_PASSWORD=
# postgresql://<user>:<password>@postgres:5432/<db>
DATABASE_URL=

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# redis://:<password>@redis:6379/0
REDIS_URL=

# --- Application secrets (generated by the installer) ---
APP_SECRET=
INTERNAL_API_TOKEN=

# --- Backups ---
BACKUP_DIR=/opt/zedbot/backups
# When set, backups are encrypted (AES-256). Keep a copy of this password
# somewhere safe OUTSIDE the server - encrypted backups are useless without
# it. Empty value = unencrypted backups.
BACKUP_ENCRYPTION_PASSWORD=

# --- Paths (used by docker-compose bind mounts) ---
ZEDBOT_DATA_DIR=/opt/zedbot/data
