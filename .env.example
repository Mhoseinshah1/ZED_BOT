# =============================================================================
# ZED_BOT environment configuration (example)
#
# scripts/install.sh generates the real .env interactively. To configure by
# hand instead: copy this file to .env, fill in the values and run
#   chmod 600 .env
# Never commit the real .env - it contains credentials.
# =============================================================================

# --- Application ---
NODE_ENV=production
APP_NAME=ZED_BOT
# Domain name of this server (IP addresses are not supported)
APP_DOMAIN=
# Public base URL, normally https://<APP_DOMAIN>
APP_BASE_URL=
API_PORT=3000
# debug | info | warn | error
LOG_LEVEL=info

# --- SSL (reverse proxy / certificates land in a later phase) ---
# Email used for SSL certificates; defaults to admin@<APP_DOMAIN>
SSL_EMAIL=

# --- Telegram ---
# Bot token from @BotFather. This ONE variable is read by BOTH the bot and the
# worker (log-group setup, operational logs, notifications, backup notices,
# Stars recovery). Set only this key.
# (Legacy: BOT_TOKEN is still accepted as a fallback for older installs, but do
#  NOT set both — if both are present with different values the config fails
#  closed. New installs should use TELEGRAM_BOT_TOKEN only.)
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs with admin access
ADMIN_TELEGRAM_IDS=

# --- PostgreSQL ---
POSTGRES_DB=zedbot
POSTGRES_USER=zedbot
POSTGRES_PASSWORD=
# postgresql://<user>:<password>@postgres:5432/<db>
DATABASE_URL=

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# redis://:<password>@redis:6379/0
REDIS_URL=

# --- Application secrets (generated by the installer) ---
APP_SECRET=
INTERNAL_API_TOKEN=

# --- Backups ---
# HOST directory holding all backups. Used by the installer, the zedbot CLI
# and the docker-compose bind mount (bot mounts it read-only, worker
# read-write). Owned by ZEDBOT_RUNTIME_UID/GID with mode 750.
ZEDBOT_BACKUP_DIR=/opt/zedbot/backups
# IN-CONTAINER backup path. docker-compose.yml pins this to
# /var/lib/zedbot/backups for the bot and worker services (compose
# `environment` overrides env_file), so normally leave it empty. Never point
# it at a host path - it does NOT relocate host backups (use
# ZEDBOT_BACKUP_DIR for that).
BACKUP_DIR=
# Days to keep database backups; retention runs after each successful backup.
BACKUP_RETENTION_DAYS=14
# Never prune below this many newest database backups, regardless of age.
BACKUP_MIN_RETAINED=3
# UID/GID the app containers run as (the image's node user). The installer
# and `zedbot repair backups` chown ZEDBOT_BACKUP_DIR to this owner.
ZEDBOT_RUNTIME_UID=1000
ZEDBOT_RUNTIME_GID=1000
# Largest backup (in MB) the worker will upload to Telegram; bigger files
# stay on disk only.
BACKUP_MAX_TELEGRAM_MB=45
# Minimum free disk space (in MB) required before creating a new backup.
BACKUP_MIN_FREE_DISK_MB=500
# When set, database backups are encrypted at rest with AES-256-GCM (the
# "ZBK1" envelope, produced by the worker). Keep a copy of this password
# somewhere safe OUTSIDE the server - encrypted backups are useless without
# it. Empty value = unencrypted backups.
BACKUP_ENCRYPTION_PASSWORD=

# --- Paths (used by docker-compose bind mounts) ---
ZEDBOT_DATA_DIR=/opt/zedbot/data

# --- Payment gateways ---
# Zarinpal merchant UUID (empty disables the Zarinpal gateway)
ZARINPAL_MERCHANT_ID=
# "true" routes all Zarinpal calls to the sandbox host
ZARINPAL_SANDBOX=false
# Absolute payment redirect callback URL, e.g. https://<APP_DOMAIN>/payments/zarinpal/callback
ZARINPAL_CALLBACK_URL=
# NOWPayments API key (empty disables the NOWPayments gateway)
NOWPAYMENTS_API_KEY=
# NOWPayments IPN HMAC secret used to verify webhook signatures
NOWPAYMENTS_IPN_SECRET=
# Absolute IPN callback URL, e.g. https://<APP_DOMAIN>/payments/nowpayments/ipn
NOWPAYMENTS_CALLBACK_URL=
# "true" routes all NOWPayments calls to the sandbox host
NOWPAYMENTS_SANDBOX=false
# Fiat currency NOWPayments invoices are priced in
NOWPAYMENTS_PRICE_CURRENCY=usd
# Operator-set conversion rate: toman per 1 unit of the price currency
NOWPAYMENTS_TOMAN_PER_UNIT=
# "true" enables Telegram Stars payments (the toman/star rate comes from the admin Stars settings)
TELEGRAM_STARS_ENABLED=false
# Bot username without @, used for the "back to bot" link on payment result pages
TELEGRAM_BOT_USERNAME=
# Timeout for payment provider HTTP calls, in milliseconds
PAYMENT_HTTP_TIMEOUT_MS=10000

# --- Service live sync ---
# Freshness window for the automatic service sync that runs when a user
# opens a service page: a row synced this recently is served without a new
# panel call. 0 disables the cache (every open hits the panel).
SERVICE_SYNC_TTL_SECONDS=60
# How long opening a service page may wait for the panel, in milliseconds.
# On expiry the page renders the last stored values; the sync finishes in
# the background and lands in the database for the next open.
SERVICE_SYNC_DISPLAY_TIMEOUT_MS=8000
# "true" also live-syncs the services shown on the "My Services" list page
SERVICE_LIST_SYNC_ENABLED=false
