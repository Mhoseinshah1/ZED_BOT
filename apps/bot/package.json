{
  "name": "@zedbot/bot",
  "version": "0.1.0",
  "private": true,
  "description": "ZED_BOT Telegram bot service (grammY)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@zedbot/database": "workspace:*",
    "@zedbot/force-join": "workspace:*",
    "@zedbot/panel-adapters": "workspace:*",
    "@zedbot/payments": "workspace:*",
    "@zedbot/service-renewal": "workspace:*",
    "@zedbot/shared": "workspace:*",
    "@zedbot/support-tickets": "workspace:*",
    "bullmq": "^5.34.0",
    "grammy": "^1.34.0",
    "ioredis": "^5.10.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
