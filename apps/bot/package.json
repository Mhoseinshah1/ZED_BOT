{
  "name": "@zedbot/bot",
  "version": "0.1.0",
  "private": true,
  "description": "ZED_BOT Telegram bot service (grammY)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@zedbot/database": "workspace:*",
    "@zedbot/panel-adapters": "workspace:*",
    "@zedbot/shared": "workspace:*",
    "grammy": "^1.34.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
